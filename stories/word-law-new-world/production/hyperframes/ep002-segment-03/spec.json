  "tts": [
    {"text": "临时规则，火焰听命。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷淡宣告规则生效。", "output": "audio/broadcast-01.mp3", "speech_rate": -2},
    {"text": "真的成了。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陌生幸存者惊喜、发抖，像不敢相信。", "output": "audio/survivor-01.mp3", "speech_rate": 4},
    {"text": "他以为自己赢了。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷静、带怜悯。", "output": "audio/inner-01.mp3", "speech_rate": 5},
    {"text": "可规则给出的力量，从来不带刹车。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，压低，危险预感。", "output": "audio/inner-02.mp3", "speech_rate": 4},
    {"text": "我的言灵还能用一次。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，快速判断。", "output": "audio/inner-03.mp3", "speech_rate": 5},
    {"text": "命令越短，反噬越轻。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷静规则说明。", "output": "audio/inner-04.mp3", "speech_rate": 5},
    {"text": "但要让火听懂，就必须足够明确。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，紧张计算。", "output": "audio/inner-05.mp3", "speech_rate": 5},
    {"text": "后退！", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚急促大喊，保护人群。", "output": "audio/ning-01.mp3", "speech_rate": 8},
    {"text": "宁晚，低头！", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野急喊，命令但不是言灵。", "output": "audio/lu-01.mp3", "speech_rate": 8},
    {"text": "上一世，我没来得及喊她的名字。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，痛感闪回。", "output": "audio/inner-06.mp3", "speech_rate": 4},
    {"text": "伏。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野言灵命令，极短、低沉、有压迫。", "output": "audio/lu-command.mp3", "speech_rate": -4},
    {"text": "这一次，我只用一个字。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，压住反噬。", "output": "audio/inner-07.mp3", "speech_rate": 4},
    {"text": "也要把她从死局里拉回来。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，坚定、收尾。", "output": "audio/inner-08.mp3", "speech_rate": 4}
  ],
