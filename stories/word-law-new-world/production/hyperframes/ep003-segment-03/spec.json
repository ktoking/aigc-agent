  "tts": [
    {"text": "冷静者样本，进入拍卖。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷酷宣告。", "output": "audio/broadcast-01.mp3", "speech_rate": -2},
    {"text": "放开我。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚咬牙反抗。", "output": "audio/ning-01.mp3", "speech_rate": 5},
    {"text": "他们不是在抢她的命。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，压低。", "output": "audio/inner-01.mp3", "speech_rate": 4},
    {"text": "是在抢她还清醒的脑子。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，愤怒。", "output": "audio/inner-02.mp3", "speech_rate": 4},
    {"text": "宁晚！", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野急喊。", "output": "audio/lu-01.mp3", "speech_rate": 8},
    {"text": "我已经死过一次。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，急促但稳。", "output": "audio/inner-03.mp3", "speech_rate": 5},
    {"text": "不会再看她被规则拖走第二次。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，坚定。", "output": "audio/inner-04.mp3", "speech_rate": 4},
    {"text": "她不是货。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野对规则喊话，愤怒、清晰。", "output": "audio/lu-02.mp3", "speech_rate": 0},
    {"text": "拍卖不接受否认。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷酷驳回。", "output": "audio/broadcast-02.mp3", "speech_rate": -2},
    {"text": "那就不否认。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，突然找到破口。", "output": "audio/inner-05.mp3", "speech_rate": 3},
    {"text": "我只需要改一个字。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，痛中冷静。", "output": "audio/inner-06.mp3", "speech_rate": 4},
    {"text": "把她的价格，改成零。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，结尾狠劲。", "output": "audio/inner-07.mp3", "speech_rate": 3}
  ],
