  "tts": [
    {"text": "拍卖不接受否认。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，痛中冷静。", "output": "audio/inner-01.mp3", "speech_rate": 4},
    {"text": "但它接受价格。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，找到破口。", "output": "audio/inner-02.mp3", "speech_rate": 4},
    {"text": "归零。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野言灵命令，低沉、狠、短。", "output": "audio/lu-command.mp3", "speech_rate": -5},
    {"text": "底价异常。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，出现系统异常。", "output": "audio/broadcast-01.mp3", "speech_rate": -2},
    {"text": "陆野！", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚脱困后急喊。", "output": "audio/ning-01.mp3", "speech_rate": 7},
    {"text": "她的价格消失了。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，松一口气但还危险。", "output": "audio/inner-03.mp3", "speech_rate": 4},
    {"text": "我没有赢。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，清醒。", "output": "audio/inner-04.mp3", "speech_rate": 4},
    {"text": "我只是把桌子掀开了一角。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷、爽。", "output": "audio/inner-05.mp3", "speech_rate": 4},
    {"text": "规则污染确认。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，危险警报。", "output": "audio/broadcast-02.mp3", "speech_rate": -2},
    {"text": "清除程序，启动。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷酷宣判。", "output": "audio/broadcast-03.mp3", "speech_rate": -2},
    {"text": "下一秒，拍卖场派出了真正的猎犬。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，结尾钩子。", "output": "audio/inner-06.mp3", "speech_rate": 3}
