  "tts": [
    {"text": "竞价物，可为记忆。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷淡宣告规则。", "output": "audio/broadcast-01.mp3", "speech_rate": -2},
    {"text": "可为寿命。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷淡宣告规则。", "output": "audio/broadcast-02.mp3", "speech_rate": -2},
    {"text": "可为真名。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，最后一项更危险。", "output": "audio/broadcast-03.mp3", "speech_rate": -2},
    {"text": "它没有解释活下去。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷静识破陷阱。", "output": "audio/inner-01.mp3", "speech_rate": 5},
    {"text": "它只解释拿什么换。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，低沉、危险。", "output": "audio/inner-02.mp3", "speech_rate": 5},
    {"text": "我出价！让我活！", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陌生幸存者崩溃喊叫，急促、绝望。", "output": "audio/survivor-01.mp3", "speech_rate": 8},
    {"text": "上一世，我见过这种眼神。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，回忆感，压低。", "output": "audio/inner-03.mp3", "speech_rate": 5},
    {"text": "快死的人，最容易相信交易。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷静且沉痛。", "output": "audio/inner-04.mp3", "speech_rate": 4},
    {"text": "你放手。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚压低声音，警惕且生气。", "output": "audio/ning-01.mp3", "speech_rate": 3},
    {"text": "别碰那东西。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野低声命令，短促、急。", "output": "audio/lu-01.mp3", "speech_rate": 0},
    {"text": "凭什么信你？", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚质问，防备、不服。", "output": "audio/ning-02.mp3", "speech_rate": 4},
    {"text": "因为我见过它收账。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，低沉、确定。", "output": "audio/inner-05.mp3", "speech_rate": 4},
    {"text": "出价成立。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷酷确认。", "output": "audio/broadcast-04.mp3", "speech_rate": -2},
    {"text": "规则从不骗人。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷。", "output": "audio/inner-06.mp3", "speech_rate": 4},
    {"text": "它只是不说完整。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，收尾压迫。", "output": "audio/inner-07.mp3", "speech_rate": 2}
  ],
