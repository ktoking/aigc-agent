  "tts": [
    {"text": "你还撑得住吗？", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚担心但克制，声音压低。", "output": "audio/ning-01.mp3", "speech_rate": 3},
    {"text": "反噬像钉子，从骨头里往外顶。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，痛苦但压住。", "output": "audio/inner-01.mp3", "speech_rate": 3},
    {"text": "可拍卖还没结束。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷静撑住。", "output": "audio/inner-02.mp3", "speech_rate": 4},
    {"text": "我出价。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野低声开口，坚定。", "output": "audio/lu-01.mp3", "speech_rate": -1},
    {"text": "你疯了？", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚惊慌质问。", "output": "audio/ning-02.mp3", "speech_rate": 5},
    {"text": "寿命不能给。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，快速判断。", "output": "audio/inner-03.mp3", "speech_rate": 5},
    {"text": "记忆不能给。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，快速判断。", "output": "audio/inner-04.mp3", "speech_rate": 5},
    {"text": "那就拿它最想要的东西。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，低沉、冒险。", "output": "audio/inner-05.mp3", "speech_rate": 4},
    {"text": "检测到真名抵押。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷酷读取。", "output": "audio/broadcast-01.mp3", "speech_rate": -2},
    {"text": "拍卖暂停。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，短促停顿。", "output": "audio/broadcast-02.mp3", "speech_rate": -3},
    {"text": "我赌的不是命。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷静反制。", "output": "audio/inner-06.mp3", "speech_rate": 4},
    {"text": "是它不敢立刻收我的命。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，聪明、狠。", "output": "audio/inner-07.mp3", "speech_rate": 4},
    {"text": "陆野，准入规则拍卖场。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，宣布资格。", "output": "audio/broadcast-03.mp3", "speech_rate": -2},
    {"text": "它终于不再把我当猎物。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷下来。", "output": "audio/inner-08.mp3", "speech_rate": 4},
    {"text": "它开始把我当玩家。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，结尾钩子，带狠劲。", "output": "audio/inner-09.mp3", "speech_rate": 2}
  ],
