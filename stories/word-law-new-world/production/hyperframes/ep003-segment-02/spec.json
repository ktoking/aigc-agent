  "tts": [
    {"text": "所有入场者，自动估价。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷酷宣告。", "output": "audio/broadcast-01.mp3", "speech_rate": -2},
    {"text": "在这里，人不是人。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，低沉。", "output": "audio/inner-01.mp3", "speech_rate": 5},
    {"text": "是可以被写进规则的材料。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，冷、压迫。", "output": "audio/inner-02.mp3", "speech_rate": 4},
    {"text": "它盯上我了。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚低声，警惕和恐惧。", "output": "audio/ning-01.mp3", "speech_rate": 3},
    {"text": "她的标签比别人亮。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，发现异常。", "output": "audio/inner-03.mp3", "speech_rate": 5},
    {"text": "因为她一直保持清醒。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，压低。", "output": "audio/inner-04.mp3", "speech_rate": 5},
    {"text": "冷静，在这个世界也是一种货。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，怒意开始。", "output": "audio/inner-05.mp3", "speech_rate": 4},
    {"text": "站到我身后。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "陆野低声命令，保护。", "output": "audio/lu-01.mp3", "speech_rate": 0},
    {"text": "我不可能再让规则把她带走。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，坚定。", "output": "audio/inner-06.mp3", "speech_rate": 4},
    {"text": "样本锁定。", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "机械广播女声，冷酷短句。", "output": "audio/broadcast-02.mp3", "speech_rate": -2},
    {"text": "陆野！", "speaker": "ICL_uranus_zh_female_xingganmeihuo_tob", "context": "宁晚突然惊呼。", "output": "audio/ning-02.mp3", "speech_rate": 8},
    {"text": "下一秒，拍卖开始点她的名。", "speaker": "zh_male_taocheng_uranus_bigtts", "context": "男主陆野内心旁白，结尾钩子。", "output": "audio/inner-07.mp3", "speech_rate": 4}
  ],
