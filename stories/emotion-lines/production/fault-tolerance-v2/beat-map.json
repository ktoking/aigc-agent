{
  "bpm_estimate": 112.9,
  "cues": [
    {
      "start": 0,
      "end": 3.245,
      "title": "你以为，人生只有一条路。",
      "sub": "每一步，都得刚好走对。"
    },
    {
      "start": 3.245,
      "end": 8.535,
      "title": "选错一步，就全盘结束？",
      "sub": "路断了，人还在。"
    },
    {
      "start": 8.535,
      "end": 12.785,
      "title": "退回路口，",
      "sub": "不等于回到起点。"
    },
    {
      "start": 12.785,
      "end": 17.035,
      "title": "换一条路，",
      "sub": "还可以继续往前。"
    },
    {
      "start": 17.035,
      "end": 19.195,
      "title": "一次选择后面，",
      "sub": "还有下一次选择。"
    },
    {
      "start": 19.195,
      "end": 23.445,
      "title": "重来。换城。学一门本事。",
      "sub": "新的路，从尝试里长出来。"
    },
    {
      "start": 23.445,
      "end": 26.635,
      "title": "这一条走不通，",
      "sub": "就退一步，试另一条。"
    },
    {
      "start": 26.635,
      "end": 29.815,
      "title": "绕过的路，",
      "sub": "也能连接新的可能。"
    },
    {
      "start": 29.815,
      "end": 33.005,
      "title": "你看见别人，一路向前。",
      "sub": "却没看见，他怎样走到这里。"
    },
    {
      "start": 33.005,
      "end": 35.665,
      "title": "那些没有走通的尝试，",
      "sub": "不一定写进最后的故事。"
    },
    {
      "start": 35.665,
      "end": 38.325,
      "title": "走通的那一条，",
      "sub": "背后也有回退和改道。"
    },
    {
      "start": 38.325,
      "end": 42.575,
      "title": "有时，旧路真的全断了。",
      "sub": "先留住那个还在的自己。"
    },
    {
      "start": 42.575,
      "end": 46.825,
      "title": "从此刻，再长出一条。",
      "sub": "先走一步，再看下一步。"
    },
    {
      "start": 46.825,
      "end": 51.075,
      "title": "容错率，不是永远不跌倒。",
      "sub": "是跌倒以后，仍有路可走。"
    },
    {
      "start": 51.075,
      "end": 55.325,
      "title": "走过的路，会连成网。",
      "sub": "下一次选择，还在前面。"
    },
    {
      "start": 55.325,
      "end": 57.445,
      "title": "失败的，是一次选择。",
      "sub": "继续走的，是你。"
    },
    {
      "start": 57.445,
      "end": 60,
      "title": "人生，允许改道。",
      "sub": "你不必一次，就走到答案。"
    }
  ],
