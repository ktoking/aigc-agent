{
  "source": "原片原始 AAC 音轨；BGM 名称由用户确认：we never（若如初见）",
  "bpm_estimate": 112.9,
  "source_in": 0,
  "source_out": 60,
  "playback_rate": 1,
  "cues": [
    {
      "start": 0,
      "end": 3.245,
      "title": "一次失误，能有多大？",
      "sub": "那个被放大的瞬间"
    },
    {
      "start": 3.245,
      "end": 6.445,
      "title": "一句话说错了。",
      "sub": "一场面试没发挥好。"
    },
    {
      "start": 6.445,
      "end": 9.625,
      "title": "你开始反复回放。",
      "sub": "每想一次，它就大一点。"
    },
    {
      "start": 9.625,
      "end": 12.285,
      "title": "把一个瞬间，",
      "sub": "放大成了全部。"
    },
    {
      "start": 12.285,
      "end": 15.465,
      "title": "最后，对自己说：",
      "sub": "“我就是不行。”"
    },
    {
      "start": 15.465,
      "end": 18.665,
      "title": "可你也许只是——",
      "sub": "靠得太近。"
    },
    {
      "start": 18.665,
      "end": 21.845,
      "title": "试着退后一点。",
      "sub": "看看它之外，还有什么。"
    },
    {
      "start": 21.845,
      "end": 25.035,
      "title": "那只是一个节点，",
      "sub": "不是你的全部。"
    },
    {
      "start": 25.035,
      "end": 28.225,
      "title": "你做成过的事，",
      "sub": "没有因此消失。"
    },
    {
      "start": 28.225,
      "end": 31.415,
      "title": "先别急着定义自己。",
      "sub": "把目光，放回这件事。"
    },
    {
      "start": 31.415,
      "end": 34.605,
      "title": "把「我不行」，",
      "sub": "换成一个具体问题。"
    },
    {
      "start": 34.605,
      "end": 37.785,
      "title": "是准备不足？",
      "sub": "还是方法不合适？"
    },
    {
      "start": 37.785,
      "end": 40.975,
      "title": "能补的，去补。",
      "sub": "能改的，去改。"
    },
    {
      "start": 40.975,
      "end": 44.705,
      "title": "暂时改不了的，",
      "sub": "也可以先放一放。"
    },
    {
      "start": 44.705,
      "end": 47.895,
      "title": "一次失误，",
      "sub": "不需要用整个人来偿还。"
    },
    {
      "start": 47.895,
      "end": 51.075,
      "title": "今天可以有遗憾。",
      "sub": "明天仍然可以有下一步。"
    },
    {
      "start": 51.075,
      "end": 54.255,
      "title": "别把一次失误，",
      "sub": "判成整个人失败。"
    },
    {
      "start": 54.255,
      "end": 57.445,
      "title": "你可以犯一次错。",
      "sub": "也可以继续往前走。"
    },
    {
      "start": 57.445,
      "end": 60,
      "title": "给自己，",
      "sub": "留一条继续走的路。"
    }
  ],
