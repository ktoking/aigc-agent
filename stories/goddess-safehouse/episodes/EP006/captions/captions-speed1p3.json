  "entries": [
    {
      "text": "第二天，",
      "display_text": "第二天",
      "start_frame": 0,
      "cue_id": "EP006-C01",
      "source_start_char": 0,
      "source_end_char": 4,
      "end_frame": 27
    },
    {
      "text": "我去物流园补资料，",
      "display_text": "我去物流园补资料",
      "start_frame": 27,
      "cue_id": "EP006-C01",
      "source_start_char": 4,
      "source_end_char": 13,
      "end_frame": 69
    },
    {
      "text": "刚好走到办公室门口，",
      "display_text": "刚好走到办公室门口",
      "start_frame": 69,
      "cue_id": "EP006-C01",
      "source_start_char": 13,
      "source_end_char": 23,
      "end_frame": 115
    },
    {
      "text": "听见马主任把一张通知拍在桌上。",
      "display_text": "听见马主任把一张通知拍在桌上",
      "start_frame": 115,
      "cue_id": "EP006-C01",
      "source_start_char": 23,
      "source_end_char": 38,
      "end_frame": 182
    },
    {
      "text": "他说，",
      "display_text": "他说",
      "start_frame": 191,
      "cue_id": "EP006-C02",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 210
    },
    {
      "text": "谁让你拦客户的货？",
      "display_text": "谁让你拦客户的货",
      "start_frame": 210,
      "cue_id": "EP006-C02",
      "source_start_char": 3,
      "source_end_char": 12,
      "end_frame": 251
    },
    {
      "text": "你一个保安，查什么货？",
      "display_text": "你一个保安 查什么货",
      "start_frame": 251,
      "cue_id": "EP006-C02",
      "source_start_char": 12,
      "source_end_char": 23,
      "end_frame": 299
    },
    {
      "text": "明天不用来了。夏凛只说，",
      "display_text": "明天不用来了 夏凛只说",
      "start_frame": 299,
      "cue_id": "EP006-C02",
      "source_start_char": 23,
      "source_end_char": 35,
      "end_frame": 357
    },
    {
      "text": "按规定巡查。马主任说，",
      "display_text": "按规定巡查 马主任说",
      "start_frame": 357,
      "cue_id": "EP006-C02",
      "source_start_char": 35,
      "source_end_char": 46,
      "end_frame": 413
    },
    {
      "text": "规定是我定的。",
      "display_text": "规定是我定的",
      "start_frame": 413,
      "cue_id": "EP006-C02",
      "source_start_char": 46,
      "source_end_char": 53,
      "end_frame": 446
    },
    {
      "text": "我在走廊等她出来。",
      "display_text": "我在走廊等她出来",
      "start_frame": 453,
      "cue_id": "EP006-C03",
      "source_start_char": 0,
      "source_end_char": 9,
      "end_frame": 493
    },
    {
      "text": "她怀里的纸箱，",
      "display_text": "她怀里的纸箱",
      "start_frame": 493,
      "cue_id": "EP006-C03",
      "source_start_char": 9,
      "source_end_char": 16,
      "end_frame": 520
    },
    {
      "text": "只装着一个水杯，一块夹板，",
      "display_text": "只装着一个水杯 一块夹板",
      "start_frame": 520,
      "cue_id": "EP006-C03",
      "source_start_char": 16,
      "source_end_char": 29,
      "end_frame": 581
    },
    {
      "text": "和那本旧本子。",
      "display_text": "和那本旧本子",
      "start_frame": 581,
      "cue_id": "EP006-C03",
      "source_start_char": 29,
      "source_end_char": 36,
      "end_frame": 618
    },
    {
      "text": "我递上名片，说，月薪五万，守一间屋，",
      "display_text": "我递上名片 说 月薪五万 守一间屋",
      "start_frame": 624,
      "cue_id": "EP006-C04",
      "source_start_char": 0,
      "source_end_char": 18,
      "end_frame": 718
    },
    {
      "text": "日结。她问，",
      "display_text": "日结 她问",
      "start_frame": 718,
      "cue_id": "EP006-C04",
      "source_start_char": 18,
      "source_end_char": 24,
      "end_frame": 757
    },
    {
      "text": "你精神没问题吧？",
      "display_text": "你精神没问题吧",
      "start_frame": 757,
      "cue_id": "EP006-C04",
      "source_start_char": 24,
      "source_end_char": 32,
      "end_frame": 795
    },
    {
      "text": "我说，",
      "display_text": "我说",
      "start_frame": 798,
      "cue_id": "EP006-C05",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 819
    },
    {
      "text": "园区里都传，",
      "display_text": "园区里都传",
      "start_frame": 819,
      "cue_id": "EP006-C05",
      "source_start_char": 3,
      "source_end_char": 9,
      "end_frame": 854
    },
    {
      "text": "你每个月往战友家里汇钱。",
      "display_text": "你每个月往战友家里汇钱",
      "start_frame": 854,
      "cue_id": "EP006-C05",
      "source_start_char": 9,
      "source_end_char": 21,
      "end_frame": 909
    },
    {
      "text": "你一个月工资四千二，汇八千，靠什么？",
      "display_text": "你一个月工资四千二 汇八千 靠什么",
      "start_frame": 909,
      "cue_id": "EP006-C05",
      "source_start_char": 21,
      "source_end_char": 39,
      "end_frame": 993
    },
    {
      "text": "我一次付你三个月。",
      "display_text": "我一次付你三个月",
      "start_frame": 993,
      "cue_id": "EP006-C05",
      "source_start_char": 39,
      "source_end_char": 48,
      "end_frame": 1031
    },
    {
      "text": "她眼神一冷，说，别查我。我说，",
      "display_text": "她眼神一冷 说 别查我 我说",
      "start_frame": 1039,
      "cue_id": "EP006-C06",
      "source_start_char": 0,
      "source_end_char": 15,
      "end_frame": 1124
    },
    {
      "text": "不是查，是算账。",
      "display_text": "不是查 是算账",
      "start_frame": 1124,
      "cue_id": "EP006-C06",
      "source_start_char": 15,
      "source_end_char": 23,
      "end_frame": 1163
    },
    {
      "text": "她沉默了很久，说，先看屋。",
      "display_text": "她沉默了很久 说 先看屋",
      "start_frame": 1163,
      "cue_id": "EP006-C06",
      "source_start_char": 23,
      "source_end_char": 36,
      "end_frame": 1235
    },
    {
      "text": "到了梧桐里，",
      "display_text": "到了梧桐里",
      "start_frame": 1243,
      "cue_id": "EP006-C07",
      "source_start_char": 0,
      "source_end_char": 6,
      "end_frame": 1271
    },
    {
      "text": "她绕着一楼转了一圈，说，窗口太低，",
      "display_text": "她绕着一楼转了一圈 说 窗口太低",
      "start_frame": 1271,
      "cue_id": "EP006-C07",
      "source_start_char": 6,
      "source_end_char": 23,
      "end_frame": 1365
    },
    {
      "text": "易攻难守。我说，不是这间。",
      "display_text": "易攻难守 我说 不是这间",
      "start_frame": 1365,
      "cue_id": "EP006-C07",
      "source_start_char": 23,
      "source_end_char": 36,
      "end_frame": 1437
    },
    {
      "text": "我推开了卧室的门。",
      "display_text": "我推开了卧室的门",
      "start_frame": 1437,
      "cue_id": "EP006-C07",
      "source_start_char": 36,
      "source_end_char": 45,
      "end_frame": 1481
    },
    {
      "text": "她右手立刻按住短棍。她摸墙，",
      "display_text": "她右手立刻按住短棍 她摸墙",
      "start_frame": 1489,
      "cue_id": "EP006-C08",
      "source_start_char": 0,
      "source_end_char": 14,
      "end_frame": 1559
    },
    {
      "text": "用脚尖敲地，",
      "display_text": "用脚尖敲地",
      "start_frame": 1559,
      "cue_id": "EP006-C08",
      "source_start_char": 14,
      "source_end_char": 20,
      "end_frame": 1587
    },
    {
      "text": "沿着货架走了一整圈。",
      "display_text": "沿着货架走了一整圈",
      "start_frame": 1587,
      "cue_id": "EP006-C08",
      "source_start_char": 20,
      "source_end_char": 30,
      "end_frame": 1637
    },
    {
      "text": "最后，",
      "display_text": "最后",
      "start_frame": 1647,
      "cue_id": "EP006-C09",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 1663
    },
    {
      "text": "她站在外墙本该在的位置，说，",
      "display_text": "她站在外墙本该在的位置 说",
      "start_frame": 1663,
      "cue_id": "EP006-C09",
      "source_start_char": 3,
      "source_end_char": 17,
      "end_frame": 1727
    },
    {
      "text": "不是投影，是实体。",
      "display_text": "不是投影 是实体",
      "start_frame": 1727,
      "cue_id": "EP006-C09",
      "source_start_char": 17,
      "source_end_char": 26,
      "end_frame": 1779
    },
    {
      "text": "两百平方米，",
      "display_text": "两百平方米",
      "start_frame": 1779,
      "cue_id": "EP006-C09",
      "source_start_char": 26,
      "source_end_char": 32,
      "end_frame": 1806
    },
    {
      "text": "从院子里根本找不到。",
      "display_text": "从院子里根本找不到",
      "start_frame": 1806,
      "cue_id": "EP006-C09",
      "source_start_char": 32,
      "source_end_char": 42,
      "end_frame": 1860
    },
    {
      "text": "我把手机递给她。绑定页，倒计时，",
      "display_text": "我把手机递给她 绑定页 倒计时",
      "start_frame": 1863,
      "cue_id": "EP006-C10",
      "source_start_char": 0,
      "source_end_char": 16,
      "end_frame": 1943
    },
    {
      "text": "距离血月降临，八十三天。",
      "display_text": "距离血月降临 八十三天",
      "start_frame": 1943,
      "cue_id": "EP006-C10",
      "source_start_char": 16,
      "source_end_char": 28,
      "end_frame": 2011
    },
    {
      "text": "她问，你疯了，",
      "display_text": "她问 你疯了",
      "start_frame": 2019,
      "cue_id": "EP006-C11",
      "source_start_char": 0,
      "source_end_char": 7,
      "end_frame": 2054
    },
    {
      "text": "还是我疯了？我说，",
      "display_text": "还是我疯了 我说",
      "start_frame": 2054,
      "cue_id": "EP006-C11",
      "source_start_char": 7,
      "source_end_char": 16,
      "end_frame": 2090
    },
    {
      "text": "你可以不信。",
      "display_text": "你可以不信",
      "start_frame": 2090,
      "cue_id": "EP006-C11",
      "source_start_char": 16,
      "source_end_char": 22,
      "end_frame": 2121
    },
    {
      "text": "但你见过的任何营地，",
      "display_text": "但你见过的任何营地",
      "start_frame": 2121,
      "cue_id": "EP006-C11",
      "source_start_char": 22,
      "source_end_char": 32,
      "end_frame": 2165
    },
    {
      "text": "有这里安全吗？",
      "display_text": "有这里安全吗",
      "start_frame": 2165,
      "cue_id": "EP006-C11",
      "source_start_char": 32,
      "source_end_char": 39,
      "end_frame": 2206
    },
    {
      "text": "我把三条屋规，",
      "display_text": "我把三条屋规",
      "start_frame": 2209,
      "cue_id": "EP006-C12",
      "source_start_char": 0,
      "source_end_char": 7,
      "end_frame": 2238
    },
    {
      "text": "放到合同旁边。",
      "display_text": "放到合同旁边",
      "start_frame": 2238,
      "cue_id": "EP006-C12",
      "source_start_char": 7,
      "source_end_char": 14,
      "end_frame": 2269
    },
    {
      "text": "不能伤害同住者，贡献记账，",
      "display_text": "不能伤害同住者 贡献记账",
      "start_frame": 2269,
      "cue_id": "EP006-C12",
      "source_start_char": 14,
      "source_end_char": 27,
      "end_frame": 2330
    },
    {
      "text": "危机时听指挥。",
      "display_text": "危机时听指挥",
      "start_frame": 2330,
      "cue_id": "EP006-C12",
      "source_start_char": 27,
      "source_end_char": 34,
      "end_frame": 2369
    },
    {
      "text": "预付款转过去，",
      "display_text": "预付款转过去",
      "start_frame": 2369,
      "cue_id": "EP006-C12",
      "source_start_char": 34,
      "source_end_char": 41,
      "end_frame": 2404
    },
    {
      "text": "到账提醒一响，她才落笔。",
      "display_text": "到账提醒一响 她才落笔",
      "start_frame": 2404,
      "cue_id": "EP006-C12",
      "source_start_char": 41,
      "source_end_char": 53,
      "end_frame": 2472
    },
    {
      "text": "她抬头，",
      "display_text": "她抬头",
      "start_frame": 2475,
      "cue_id": "EP006-C13",
      "source_start_char": 0,
      "source_end_char": 4,
      "end_frame": 2497
    },
    {
      "text": "看了一眼墙上的倒计时，问我，",
      "display_text": "看了一眼墙上的倒计时 问我",
      "start_frame": 2497,
      "cue_id": "EP006-C13",
      "source_start_char": 4,
      "source_end_char": 18,
      "end_frame": 2567
    },
    {
      "text": "归零之后，",
      "display_text": "归零之后",
      "start_frame": 2567,
      "cue_id": "EP006-C13",
      "source_start_char": 18,
      "source_end_char": 23,
      "end_frame": 2591
    },
    {
      "text": "我要守的是什么？",
      "display_text": "我要守的是什么",
      "start_frame": 2591,
      "cue_id": "EP006-C13",
      "source_start_char": 23,
      "source_end_char": 31,
      "end_frame": 2630
    }
