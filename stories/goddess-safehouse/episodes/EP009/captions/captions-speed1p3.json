    {
      "text": "西南方出现红色云层。",
      "display_text": "西南方出现红色云层",
      "start_frame": 321,
      "cue_id": "EP009-C02",
      "source_start_char": 27,
      "source_end_char": 37,
      "end_frame": 375
    },
    {
      "text": "她说，",
      "display_text": "她说",
      "start_frame": 383,
      "cue_id": "EP009-C03",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 401
    },
    {
      "text": "我在部队见过这种动物异常。",
      "display_text": "我在部队见过这种动物异常",
      "start_frame": 401,
      "cue_id": "EP009-C03",
      "source_start_char": 3,
      "source_end_char": 16,
      "end_frame": 453
    },
    {
      "text": "是地震前兆，不，",
      "display_text": "是地震前兆 不",
      "start_frame": 453,
      "cue_id": "EP009-C03",
      "source_start_char": 16,
      "source_end_char": 24,
      "end_frame": 495
    },
    {
      "text": "比地震更糟。我问，你信我了？她说，",
      "display_text": "比地震更糟 我问 你信我了 她说",
      "start_frame": 495,
      "cue_id": "EP009-C03",
      "source_start_char": 24,
      "source_end_char": 41,
      "end_frame": 579
    },
    {
      "text": "我信动物。",
      "display_text": "我信动物",
      "start_frame": 579,
      "cue_id": "EP009-C03",
      "source_start_char": 41,
      "source_end_char": 46,
      "end_frame": 604
    },
    {
      "text": "我们最后试了一次院灯。",
      "display_text": "我们最后试了一次院灯",
      "start_frame": 611,
      "cue_id": "EP009-C04",
      "source_start_char": 0,
      "source_end_char": 11,
      "end_frame": 658
    },
    {
      "text": "门外台阶和楼梯转角，白光一亮，",
      "display_text": "门外台阶和楼梯转角 白光一亮",
      "start_frame": 658,
      "cue_id": "EP009-C04",
      "source_start_char": 11,
      "source_end_char": 26,
      "end_frame": 729
    },
    {
      "text": "照得清清楚楚。",
      "display_text": "照得清清楚楚",
      "start_frame": 729,
      "cue_id": "EP009-C04",
      "source_start_char": 26,
      "source_end_char": 33,
      "end_frame": 765
    },
    {
      "text": "傍晚，",
