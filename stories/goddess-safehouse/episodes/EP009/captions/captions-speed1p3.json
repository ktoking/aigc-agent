      "display_text": "夏凛站在窗边",
      "start_frame": 188,
      "cue_id": "EP009-C02",
      "source_start_char": 0,
      "source_end_char": 7,
      "end_frame": 218
    },
    {
      "text": "只留一条缝。新闻在播，",
      "display_text": "只留一条缝 新闻在播",
      "start_frame": 218,
      "cue_id": "EP009-C02",
      "source_start_char": 7,
      "source_end_char": 18,
      "end_frame": 279
    },
    {
      "text": "多地动物集体躁动，",
      "display_text": "多地动物集体躁动",
