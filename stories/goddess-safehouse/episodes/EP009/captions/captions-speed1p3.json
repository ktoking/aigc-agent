      "text": "死活不松手。",
      "display_text": "死活不松手",
      "start_frame": 925,
      "cue_id": "EP009-C05",
      "source_start_char": 30,
      "source_end_char": 36,
      "end_frame": 957
    },
    {
      "text": "我什么都没买，",
      "display_text": "我什么都没买",
      "start_frame": 957,
      "cue_id": "EP009-C05",
      "source_start_char": 36,
      "source_end_char": 43,
      "end_frame": 987
