      "display_text": "水和盐的货架已经空了",
      "start_frame": 825,
      "cue_id": "EP009-C05",
      "source_start_char": 9,
      "source_end_char": 20,
      "end_frame": 879
    },
    {
      "text": "有人抓着最后一箱水，",
      "display_text": "有人抓着最后一箱水",
      "start_frame": 879,
      "cue_id": "EP009-C05",
      "source_start_char": 20,
      "source_end_char": 30,
      "end_frame": 925
    },
