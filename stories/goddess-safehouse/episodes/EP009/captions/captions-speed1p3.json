      "cue_id": "EP009-C08",
      "source_start_char": 22,
      "source_end_char": 34,
      "end_frame": 1561
    },
    {
      "text": "就从医院逃出来。",
      "display_text": "就从医院逃出来",
      "start_frame": 1561,
      "cue_id": "EP009-C08",
      "source_start_char": 34,
      "source_end_char": 42,
      "end_frame": 1608
    },
