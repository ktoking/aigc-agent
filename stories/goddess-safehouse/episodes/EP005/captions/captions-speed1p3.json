  "entries": [
    {
      "text": "手电光照在叉车轮子上。",
      "display_text": "手电光照在叉车轮子上",
      "start_frame": 0,
      "cue_id": "EP005-C01",
      "source_start_char": 0,
      "source_end_char": 11,
      "end_frame": 57
    },
    {
      "text": "一个女人说，停。我抬头，",
      "display_text": "一个女人说 停 我抬头",
      "start_frame": 57,
      "cue_id": "EP005-C01",
      "source_start_char": 11,
      "source_end_char": 23,
      "end_frame": 128
    },
    {
      "text": "看见她腰侧挂着一根短棍。",
      "display_text": "看见她腰侧挂着一根短棍",
      "start_frame": 128,
      "cue_id": "EP005-C01",
      "source_start_char": 23,
      "source_end_char": 35,
      "end_frame": 185
    },
    {
      "text": "她站得笔直，",
      "display_text": "她站得笔直",
      "start_frame": 189,
      "cue_id": "EP005-C02",
      "source_start_char": 0,
      "source_end_char": 6,
      "end_frame": 224
    },
    {
      "text": "右手习惯性贴着腰侧，",
      "display_text": "右手习惯性贴着腰侧",
      "start_frame": 224,
      "cue_id": "EP005-C02",
      "source_start_char": 6,
      "source_end_char": 16,
      "end_frame": 271
    },
    {
      "text": "左耳后有一道浅疤。她说，这批货，",
      "display_text": "左耳后有一道浅疤 她说 这批货",
      "start_frame": 271,
      "cue_id": "EP005-C02",
      "source_start_char": 16,
      "source_end_char": 32,
      "end_frame": 339
    },
    {
      "text": "没有报备单。",
      "display_text": "没有报备单",
      "start_frame": 339,
      "cue_id": "EP005-C02",
      "source_start_char": 32,
      "source_end_char": 38,
      "end_frame": 374
    },
    {
      "text": "我把合同递过去。",
      "display_text": "我把合同递过去",
      "start_frame": 377,
      "cue_id": "EP005-C03",
      "source_start_char": 0,
      "source_end_char": 8,
      "end_frame": 411
    },
    {
      "text": "她看得很慢，",
      "display_text": "她看得很慢",
      "start_frame": 411,
      "cue_id": "EP005-C03",
      "source_start_char": 8,
      "source_end_char": 14,
      "end_frame": 445
    },
    {
      "text": "没找到破绽，",
      "display_text": "没找到破绽",
      "start_frame": 445,
      "cue_id": "EP005-C03",
      "source_start_char": 14,
      "source_end_char": 20,
      "end_frame": 467
    },
    {
      "text": "就抽出美工刀，",
      "display_text": "就抽出美工刀",
      "start_frame": 467,
      "cue_id": "EP005-C03",
      "source_start_char": 20,
      "source_end_char": 27,
      "end_frame": 513
    },
    {
      "text": "划开一个纸箱，",
      "display_text": "划开一个纸箱",
      "start_frame": 513,
      "cue_id": "EP005-C03",
      "source_start_char": 27,
      "source_end_char": 34,
      "end_frame": 545
    },
    {
      "text": "又划开一个。",
      "display_text": "又划开一个",
      "start_frame": 545,
      "cue_id": "EP005-C03",
      "source_start_char": 34,
      "source_end_char": 40,
      "end_frame": 576
    },
    {
      "text": "柴油，压缩饼干，种子，探照灯。",
      "display_text": "柴油 压缩饼干 种子 探照灯",
      "start_frame": 582,
      "cue_id": "EP005-C04",
      "source_start_char": 0,
      "source_end_char": 15,
      "end_frame": 674
    },
    {
      "text": "她抬眼看我，说，",
      "display_text": "她抬眼看我 说",
      "start_frame": 674,
      "cue_id": "EP005-C04",
      "source_start_char": 15,
      "source_end_char": 23,
      "end_frame": 719
    },
    {
      "text": "这些东西放在一起，",
      "display_text": "这些东西放在一起",
      "start_frame": 719,
      "cue_id": "EP005-C04",
      "source_start_char": 23,
      "source_end_char": 32,
      "end_frame": 755
    },
    {
      "text": "只有两种人，邪教，",
      "display_text": "只有两种人 邪教",
      "start_frame": 755,
      "cue_id": "EP005-C04",
      "source_start_char": 32,
      "source_end_char": 41,
      "end_frame": 798
    },
    {
      "text": "和准备打仗的。",
      "display_text": "和准备打仗的",
      "start_frame": 798,
      "cue_id": "EP005-C04",
      "source_start_char": 41,
      "source_end_char": 48,
      "end_frame": 838
    },
    {
      "text": "我说，",
      "display_text": "我说",
      "start_frame": 841,
      "cue_id": "EP005-C05",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 865
    },
    {
      "text": "我是前仓储主管。",
      "display_text": "我是前仓储主管",
      "start_frame": 865,
      "cue_id": "EP005-C05",
      "source_start_char": 3,
      "source_end_char": 11,
      "end_frame": 909
    },
    {
      "text": "我囤的不是货，是命。",
      "display_text": "我囤的不是货 是命",
      "start_frame": 909,
      "cue_id": "EP005-C05",
      "source_start_char": 11,
      "source_end_char": 21,
      "end_frame": 959
    },
    {
      "text": "她握刀的手，停了半秒。她问，命？",
      "display_text": "她握刀的手 停了半秒 她问 命",
      "start_frame": 967,
      "cue_id": "EP005-C06",
      "source_start_char": 0,
      "source_end_char": 16,
      "end_frame": 1050
    },
    {
      "text": "我说，三个月后，",
      "display_text": "我说 三个月后",
      "start_frame": 1050,
      "cue_id": "EP005-C06",
      "source_start_char": 16,
      "source_end_char": 24,
      "end_frame": 1088
    },
    {
      "text": "你就知道我说得对不对。",
      "display_text": "你就知道我说得对不对",
      "start_frame": 1088,
      "cue_id": "EP005-C06",
      "source_start_char": 24,
      "source_end_char": 35,
      "end_frame": 1136
    },
    {
      "text": "她冷冷收刀。",
      "display_text": "她冷冷收刀",
      "start_frame": 1143,
      "cue_id": "EP005-C07",
      "source_start_char": 0,
      "source_end_char": 6,
      "end_frame": 1177
    },
    {
      "text": "三个月后我还在这儿当保安。",
      "display_text": "三个月后我还在这儿当保安",
      "start_frame": 1177,
      "cue_id": "EP005-C07",
      "source_start_char": 6,
      "source_end_char": 19,
      "end_frame": 1235
    },
    {
      "text": "你要是骗我，",
      "display_text": "你要是骗我",
      "start_frame": 1235,
      "cue_id": "EP005-C07",
      "source_start_char": 19,
      "source_end_char": 25,
      "end_frame": 1262
    },
    {
      "text": "我查你一辈子。",
      "display_text": "我查你一辈子",
      "start_frame": 1262,
      "cue_id": "EP005-C07",
      "source_start_char": 25,
      "source_end_char": 32,
      "end_frame": 1295
    },
    {
      "text": "补完资料，",
      "display_text": "补完资料",
      "start_frame": 1304,
      "cue_id": "EP005-C08",
      "source_start_char": 0,
      "source_end_char": 5,
      "end_frame": 1325
    },
    {
      "text": "她在回执上签了名字，夏凛。字迹很重，",
      "display_text": "她在回执上签了名字 夏凛 字迹很重",
      "start_frame": 1325,
      "cue_id": "EP005-C08",
      "source_start_char": 5,
      "source_end_char": 23,
      "end_frame": 1421
    },
    {
      "text": "像刀刻出来的。那时候，",
      "display_text": "像刀刻出来的 那时候",
      "start_frame": 1421,
      "cue_id": "EP005-C08",
      "source_start_char": 23,
      "source_end_char": 34,
      "end_frame": 1478
    },
    {
      "text": "距离血月降临，",
      "display_text": "距离血月降临",
      "start_frame": 1478,
      "cue_id": "EP005-C08",
      "source_start_char": 34,
      "source_end_char": 41,
      "end_frame": 1511
    },
    {
      "text": "还剩八十五天。",
      "display_text": "还剩八十五天",
      "start_frame": 1511,
      "cue_id": "EP005-C08",
      "source_start_char": 41,
      "source_end_char": 48,
      "end_frame": 1547
