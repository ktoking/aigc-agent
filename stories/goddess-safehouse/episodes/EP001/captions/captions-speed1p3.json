{
  "episode": "EP001",
  "fps": 30,
  "frames": 3060,
  "source": "confirmed text unchanged",
  "timing": "ASR matched characters with interpolation for unmatched characters; measured accelerated audio",
  "entries": [
    {
      "text": "王大富拿金条砸我的门时，",
      "display_text": "王大富拿金条砸我的门时",
      "start_frame": 0,
      "cue_id": "EP001-C01",
      "source_start_char": 0,
      "source_end_char": 12,
      "end_frame": 62
    },
    {
      "text": "锅里的毛肚刚下进去。",
      "display_text": "锅里的毛肚刚下进去",
      "start_frame": 62,
      "cue_id": "EP001-C01",
      "source_start_char": 12,
      "source_end_char": 22,
      "end_frame": 105
    },
    {
      "text": "他在门外喊，十根，全给你，开门。",
      "display_text": "他在门外喊 十根 全给你 开门",
      "start_frame": 105,
      "cue_id": "EP001-C01",
      "source_start_char": 22,
      "source_end_char": 38,
      "end_frame": 191
    },
    {
      "text": "我夹起毛肚，涮了七下，",
      "display_text": "我夹起毛肚 涮了七下",
      "start_frame": 200,
      "cue_id": "EP001-C02",
      "source_start_char": 0,
      "source_end_char": 11,
      "end_frame": 258
    },
    {
      "text": "隔着门回他，",
      "display_text": "隔着门回他",
      "start_frame": 258,
      "cue_id": "EP001-C02",
      "source_start_char": 11,
      "source_end_char": 17,
      "end_frame": 296
    },
    {
      "text": "当初在群里说我借钱囤货是傻子的时候，",
      "display_text": "当初在群里说我借钱囤货是傻子的时候",
      "start_frame": 296,
      "cue_id": "EP001-C02",
      "source_start_char": 17,
      "source_end_char": 35,
      "end_frame": 374
    },
    {
      "text": "你可没这么客气。",
      "display_text": "你可没这么客气",
      "start_frame": 374,
      "cue_id": "EP001-C02",
      "source_start_char": 35,
      "source_end_char": 43,
      "end_frame": 409
    },
    {
      "text": "这是血月降临的第一夜。这顿火锅，",
      "display_text": "这是血月降临的第一夜 这顿火锅",
      "start_frame": 417,
      "cue_id": "EP001-C03",
      "source_start_char": 0,
      "source_end_char": 16,
      "end_frame": 480
    },
    {
      "text": "我准备了九十天。",
      "display_text": "我准备了九十天",
      "start_frame": 480,
      "cue_id": "EP001-C03",
      "source_start_char": 16,
      "source_end_char": 24,
      "end_frame": 520
    },
    {
      "text": "九十天前，",
      "display_text": "九十天前",
      "start_frame": 527,
      "cue_id": "EP001-C04",
      "source_start_char": 0,
      "source_end_char": 5,
      "end_frame": 555
    },
    {
      "text": "我还是个被甩锅的仓储主管。马主任说，",
      "display_text": "我还是个被甩锅的仓储主管 马主任说",
      "start_frame": 555,
      "cue_id": "EP001-C04",
      "source_start_char": 5,
      "source_end_char": 23,
      "end_frame": 637
    },
    {
      "text": "三十箱货的缺口，",
      "display_text": "三十箱货的缺口",
      "start_frame": 637,
      "cue_id": "EP001-C04",
      "source_start_char": 23,
      "source_end_char": 31,
      "end_frame": 675
    },
    {
      "text": "签收单上是你的名字。",
      "display_text": "签收单上是你的名字",
      "start_frame": 675,
      "cue_id": "EP001-C04",
      "source_start_char": 31,
      "source_end_char": 41,
      "end_frame": 726
    },
    {
      "text": "我说，",
      "display_text": "我说",
      "start_frame": 730,
      "cue_id": "EP001-C05",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 750
    },
    {
      "text": "是你催我先签的。",
      "display_text": "是你催我先签的",
      "start_frame": 750,
      "cue_id": "EP001-C05",
      "source_start_char": 3,
      "source_end_char": 11,
      "end_frame": 785
    },
    {
      "text": "他一把压住单子，问我，证据呢。",
      "display_text": "他一把压住单子 问我 证据呢",
      "start_frame": 785,
      "cue_id": "EP001-C05",
      "source_start_char": 11,
      "source_end_char": 26,
      "end_frame": 852
    },
    {
      "text": "我摘下工牌，放在桌上。第二天，",
      "display_text": "我摘下工牌 放在桌上 第二天",
      "start_frame": 855,
      "cue_id": "EP001-C06",
      "source_start_char": 0,
      "source_end_char": 15,
      "end_frame": 927
    },
    {
      "text": "我就不用再来了。",
      "display_text": "我就不用再来了",
      "start_frame": 927,
      "cue_id": "EP001-C06",
      "source_start_char": 15,
      "source_end_char": 23,
      "end_frame": 969
    },
    {
      "text": "我回到父母留下的老房子，",
      "display_text": "我回到父母留下的老房子",
      "start_frame": 972,
      "cue_id": "EP001-C07",
      "source_start_char": 0,
      "source_end_char": 12,
      "end_frame": 1028
    },
    {
      "text": "梧桐里三栋一零一，",
      "display_text": "梧桐里三栋一零一",
      "start_frame": 1028,
      "cue_id": "EP001-C07",
      "source_start_char": 12,
      "source_end_char": 21,
      "end_frame": 1075
    },
    {
      "text": "连灯都没开。",
      "display_text": "连灯都没开",
      "start_frame": 1075,
      "cue_id": "EP001-C07",
      "source_start_char": 21,
      "source_end_char": 27,
      "end_frame": 1107
    },
    {
      "text": "手机自己亮了。",
      "display_text": "手机自己亮了",
      "start_frame": 1107,
      "cue_id": "EP001-C07",
      "source_start_char": 27,
      "source_end_char": 34,
      "end_frame": 1146
    },
    {
      "text": "方舟安全屋系统，已绑定。",
      "display_text": "方舟安全屋系统 已绑定",
      "start_frame": 1157,
      "cue_id": "EP001-C08",
      "source_start_char": 0,
      "source_end_char": 12,
      "end_frame": 1220
    },
    {
      "text": "下面一行数字，",
      "display_text": "下面一行数字",
      "start_frame": 1220,
      "cue_id": "EP001-C08",
      "source_start_char": 12,
      "source_end_char": 19,
      "end_frame": 1253
    },
    {
      "text": "一秒一秒往下跳，",
      "display_text": "一秒一秒往下跳",
      "start_frame": 1253,
      "cue_id": "EP001-C08",
      "source_start_char": 19,
      "source_end_char": 27,
      "end_frame": 1291
    },
    {
      "text": "距离血月降临，",
      "display_text": "距离血月降临",
      "start_frame": 1291,
      "cue_id": "EP001-C08",
      "source_start_char": 27,
      "source_end_char": 34,
      "end_frame": 1320
    },
    {
      "text": "八十九天二十三小时五十九分。",
      "display_text": "八十九天二十三小时五十九分",
      "start_frame": 1320,
      "cue_id": "EP001-C08",
      "source_start_char": 34,
      "source_end_char": 48,
      "end_frame": 1401
    },
    {
      "text": "我以为是诈骗软件。",
      "display_text": "我以为是诈骗软件",
      "start_frame": 1409,
      "cue_id": "EP001-C09",
      "source_start_char": 0,
      "source_end_char": 9,
      "end_frame": 1452
    },
    {
      "text": "直到卧室的门，",
      "display_text": "直到卧室的门",
      "start_frame": 1452,
      "cue_id": "EP001-C09",
      "source_start_char": 9,
      "source_end_char": 16,
      "end_frame": 1481
    },
    {
      "text": "自己弹开一条缝，",
      "display_text": "自己弹开一条缝",
      "start_frame": 1481,
      "cue_id": "EP001-C09",
      "source_start_char": 16,
      "source_end_char": 24,
      "end_frame": 1518
    },
    {
      "text": "白光一直照到我的鞋尖。",
      "display_text": "白光一直照到我的鞋尖",
      "start_frame": 1518,
      "cue_id": "EP001-C09",
      "source_start_char": 24,
      "source_end_char": 35,
      "end_frame": 1566
    },
    {
      "text": "十二平方米的小卧室不见了，",
      "display_text": "十二平方米的小卧室不见了",
      "start_frame": 1573,
      "cue_id": "EP001-C10",
      "source_start_char": 0,
      "source_end_char": 13,
      "end_frame": 1632
    },
    {
      "text": "门后是一间足有两百平方米的空厅。",
      "display_text": "门后是一间足有两百平方米的空厅",
      "start_frame": 1632,
      "cue_id": "EP001-C10",
      "source_start_char": 13,
      "source_end_char": 29,
      "end_frame": 1698
    },
    {
      "text": "我扔进去半包泡面，",
      "display_text": "我扔进去半包泡面",
      "start_frame": 1698,
      "cue_id": "EP001-C10",
      "source_start_char": 29,
      "source_end_char": 38,
      "end_frame": 1748
    },
    {
      "text": "它悬了一秒，无声落地。",
      "display_text": "它悬了一秒 无声落地",
      "start_frame": 1748,
      "cue_id": "EP001-C10",
      "source_start_char": 38,
      "source_end_char": 49,
      "end_frame": 1807
    },
    {
      "text": "系统说，",
      "display_text": "系统说",
      "start_frame": 1814,
      "cue_id": "EP001-C11",
      "source_start_char": 0,
      "source_end_char": 4,
      "end_frame": 1839
    },
    {
      "text": "屋里的东西不会坏，",
      "display_text": "屋里的东西不会坏",
      "start_frame": 1839,
      "cue_id": "EP001-C11",
      "source_start_char": 4,
      "source_end_char": 13,
      "end_frame": 1874
    },
    {
      "text": "屋外的怪物进不来。紧接着，一行红字，",
      "display_text": "屋外的怪物进不来 紧接着 一行红字",
      "start_frame": 1874,
      "cue_id": "EP001-C11",
      "source_start_char": 13,
      "source_end_char": 31,
      "end_frame": 1963
    },
    {
      "text": "血月降临后，",
      "display_text": "血月降临后",
      "start_frame": 1963,
      "cue_id": "EP001-C11",
      "source_start_char": 31,
      "source_end_char": 37,
      "end_frame": 1992
    },
    {
      "text": "屋外将不再适合人类生存。",
      "display_text": "屋外将不再适合人类生存",
      "start_frame": 1992,
      "cue_id": "EP001-C11",
      "source_start_char": 37,
      "source_end_char": 49,
      "end_frame": 2046
    },
    {
      "text": "我盯着银行卡，",
      "display_text": "我盯着银行卡",
      "start_frame": 2054,
      "cue_id": "EP001-C12",
      "source_start_char": 0,
      "source_end_char": 7,
      "end_frame": 2085
    },
    {
      "text": "四十一万两千。",
      "display_text": "四十一万两千",
      "start_frame": 2085,
      "cue_id": "EP001-C12",
      "source_start_char": 7,
      "source_end_char": 14,
      "end_frame": 2120
    },
    {
      "text": "又盯着那行倒计时。",
      "display_text": "又盯着那行倒计时",
      "start_frame": 2120,
      "cue_id": "EP001-C12",
      "source_start_char": 14,
      "source_end_char": 23,
      "end_frame": 2165
    },
    {
      "text": "我打开购物软件，搜索，压缩饼干。",
      "display_text": "我打开购物软件 搜索 压缩饼干",
      "start_frame": 2170,
      "cue_id": "EP001-C13",
      "source_start_char": 0,
      "source_end_char": 16,
      "end_frame": 2255
    },
    {
      "text": "顺手又买了两盒草莓，",
      "display_text": "顺手又买了两盒草莓",
      "start_frame": 2255,
      "cue_id": "EP001-C13",
      "source_start_char": 16,
      "source_end_char": 26,
      "end_frame": 2302
    },
    {
      "text": "一盒放屋里，",
      "display_text": "一盒放屋里",
      "start_frame": 2302,
      "cue_id": "EP001-C13",
      "source_start_char": 26,
      "source_end_char": 32,
      "end_frame": 2330
    },
    {
      "text": "一盒放屋外，做个对照。",
      "display_text": "一盒放屋外 做个对照",
      "start_frame": 2330,
      "cue_id": "EP001-C13",
      "source_start_char": 32,
      "source_end_char": 43,
      "end_frame": 2384
    },
    {
      "text": "第二天，",
      "display_text": "第二天",
      "start_frame": 2391,
      "cue_id": "EP001-C14",
      "source_start_char": 0,
      "source_end_char": 4,
      "end_frame": 2414
    },
    {
      "text": "我在业主群问，谁有大米，我收五吨。",
      "display_text": "我在业主群问 谁有大米 我收五吨",
      "start_frame": 2414,
      "cue_id": "EP001-C14",
      "source_start_char": 4,
      "source_end_char": 21,
      "end_frame": 2483
    },
    {
      "text": "王大富回我，",
      "display_text": "王大富回我",
      "start_frame": 2483,
      "cue_id": "EP001-C14",
      "source_start_char": 21,
      "source_end_char": 27,
      "end_frame": 2522
    },
    {
      "text": "你是要开粮店，",
      "display_text": "你是要开粮店",
      "start_frame": 2522,
      "cue_id": "EP001-C14",
      "source_start_char": 27,
      "source_end_char": 34,
      "end_frame": 2552
    },
    {
      "text": "还是脑子坏了。",
      "display_text": "还是脑子坏了",
      "start_frame": 2552,
      "cue_id": "EP001-C14",
      "source_start_char": 34,
      "source_end_char": 41,
      "end_frame": 2582
    },
    {
      "text": "满屏都是哈哈哈。",
      "display_text": "满屏都是哈哈哈",
      "start_frame": 2582,
      "cue_id": "EP001-C14",
      "source_start_char": 41,
      "source_end_char": 49,
      "end_frame": 2625
    },
    {
      "text": "我关掉群聊，",
      "display_text": "我关掉群聊",
      "start_frame": 2631,
      "cue_id": "EP001-C15",
      "source_start_char": 0,
      "source_end_char": 6,
      "end_frame": 2663
    },
    {
      "text": "心里只有一个字，笑吧。",
      "display_text": "心里只有一个字 笑吧",
      "start_frame": 2663,
      "cue_id": "EP001-C15",
      "source_start_char": 6,
      "source_end_char": 17,
      "end_frame": 2716
    },
    {
      "text": "当晚，",
      "display_text": "当晚",
      "start_frame": 2724,
      "cue_id": "EP001-C16",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 2745
    },
    {
      "text": "空厅的墙上，",
      "display_text": "空厅的墙上",
      "start_frame": 2745,
      "cue_id": "EP001-C16",
      "source_start_char": 3,
      "source_end_char": 9,
      "end_frame": 2778
    },
    {
      "text": "亮起一行红字，警告，",
      "display_text": "亮起一行红字 警告",
      "start_frame": 2778,
      "cue_id": "EP001-C16",
      "source_start_char": 9,
      "source_end_char": 19,
      "end_frame": 2835
    },
    {
      "text": "检测到同类信号，数量未知。",
      "display_text": "检测到同类信号 数量未知",
      "start_frame": 2835,
      "cue_id": "EP001-C16",
      "source_start_char": 19,
      "source_end_char": 32,
      "end_frame": 2906
    },
    {
      "text": "我猛地回头，",
      "display_text": "我猛地回头",
      "start_frame": 2913,
      "cue_id": "EP001-C17",
      "source_start_char": 0,
      "source_end_char": 6,
      "end_frame": 2945
    },
    {
      "text": "屋里空无一人。原来，",
      "display_text": "屋里空无一人 原来",
      "start_frame": 2945,
      "cue_id": "EP001-C17",
      "source_start_char": 6,
      "source_end_char": 16,
      "end_frame": 3000
    },
    {
      "text": "收到倒计时的，",
      "display_text": "收到倒计时的",
      "start_frame": 3000,
      "cue_id": "EP001-C17",
      "source_start_char": 16,
      "source_end_char": 23,
      "end_frame": 3024
    },
    {
      "text": "不止我一个。",
      "display_text": "不止我一个",
      "start_frame": 3024,
      "cue_id": "EP001-C17",
      "source_start_char": 23,
      "source_end_char": 29,
      "end_frame": 3060
    }
  ],
