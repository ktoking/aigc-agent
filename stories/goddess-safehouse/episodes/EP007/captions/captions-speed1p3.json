  "timing": "ASR matched characters with interpolation for unmatched characters; measured accelerated audio",
  "entries": [
    {
      "text": "那天我对她说，",
      "display_text": "那天我对她说",
      "start_frame": 0,
      "cue_id": "EP007-C01",
      "source_start_char": 0,
      "source_end_char": 7,
      "end_frame": 42
    },
    {
      "text": "先守住这扇门，里面有我，也有你。",
      "display_text": "先守住这扇门 里面有我 也有你",
      "start_frame": 42,
      "cue_id": "EP007-C01",
      "source_start_char": 7,
      "source_end_char": 23,
      "end_frame": 121
    },
    {
      "text": "当夜，",
      "display_text": "当夜",
      "start_frame": 121,
      "cue_id": "EP007-C01",
      "source_start_char": 23,
      "source_end_char": 26,
      "end_frame": 142
    },
    {
      "text": "夏凛不肯睡卧室。",
      "display_text": "夏凛不肯睡卧室",
      "start_frame": 142,
      "cue_id": "EP007-C01",
      "source_start_char": 26,
      "source_end_char": 34,
      "end_frame": 181
    },
    {
      "text": "她在沙发旁铺了一层垫子，手握短棍，",
      "display_text": "她在沙发旁铺了一层垫子 手握短棍",
      "start_frame": 191,
      "cue_id": "EP007-C02",
      "source_start_char": 0,
      "source_end_char": 17,
      "end_frame": 278
    },
    {
      "text": "眼睛盯着门。",
      "display_text": "眼睛盯着门",
      "start_frame": 278,
      "cue_id": "EP007-C02",
      "source_start_char": 17,
      "source_end_char": 23,
      "end_frame": 308
    },
    {
      "text": "我给她煮了碗面，端过去，她说不饿。",
      "display_text": "我给她煮了碗面 端过去 她说不饿",
      "start_frame": 308,
      "cue_id": "EP007-C02",
      "source_start_char": 23,
      "source_end_char": 40,
      "end_frame": 390
    },
    {
      "text": "等我转身去整理货架，",
      "display_text": "等我转身去整理货架",
      "start_frame": 395,
      "cue_id": "EP007-C03",
      "source_start_char": 0,
      "source_end_char": 10,
      "end_frame": 441
    },
    {
      "text": "她已经把面吃完，",
      "display_text": "她已经把面吃完",
      "start_frame": 441,
      "cue_id": "EP007-C03",
      "source_start_char": 10,
      "source_end_char": 18,
      "end_frame": 476
    },
    {
      "text": "连汤都没剩。",
      "display_text": "连汤都没剩",
      "start_frame": 476,
      "cue_id": "EP007-C03",
      "source_start_char": 18,
      "source_end_char": 24,
      "end_frame": 509
    },
    {
      "text": "后半夜，",
      "display_text": "后半夜",
      "start_frame": 517,
      "cue_id": "EP007-C04",
      "source_start_char": 0,
      "source_end_char": 4,
      "end_frame": 541
    },
    {
      "text": "我出来收碗。",
      "display_text": "我出来收碗",
      "start_frame": 541,
      "cue_id": "EP007-C04",
      "source_start_char": 4,
      "source_end_char": 10,
      "end_frame": 569
    },
    {
      "text": "她靠着墙坐着，",
      "display_text": "她靠着墙坐着",
      "start_frame": 569,
      "cue_id": "EP007-C04",
      "source_start_char": 10,
      "source_end_char": 17,
      "end_frame": 605
    },
    {
      "text": "头一点一点，",
      "display_text": "头一点一点",
      "start_frame": 605,
      "cue_id": "EP007-C04",
      "source_start_char": 17,
      "source_end_char": 23,
      "end_frame": 634
    },
    {
      "text": "短棍滑到了垫子上。",
      "display_text": "短棍滑到了垫子上",
      "start_frame": 634,
      "cue_id": "EP007-C04",
      "source_start_char": 23,
      "source_end_char": 32,
      "end_frame": 674
    },
    {
      "text": "我给她盖上毯子，没叫醒她。",
      "display_text": "我给她盖上毯子 没叫醒她",
      "start_frame": 674,
      "cue_id": "EP007-C04",
      "source_start_char": 32,
      "source_end_char": 45,
      "end_frame": 737
    },
    {
      "text": "手机弹出一行提示，",
      "display_text": "手机弹出一行提示",
      "start_frame": 747,
      "cue_id": "EP007-C05",
      "source_start_char": 0,
      "source_end_char": 9,
      "end_frame": 792
    },
    {
      "text": "住客深度睡眠六小时，安心值，加二十。",
      "display_text": "住客深度睡眠六小时 安心值 加二十",
      "start_frame": 792,
      "cue_id": "EP007-C05",
      "source_start_char": 9,
      "source_end_char": 27,
      "end_frame": 872
    },
    {
      "text": "原来，",
      "display_text": "原来",
      "start_frame": 872,
      "cue_id": "EP007-C05",
      "source_start_char": 27,
      "source_end_char": 30,
      "end_frame": 890
    },
    {
      "text": "安心值是这么算的。",
      "display_text": "安心值是这么算的",
      "start_frame": 890,
      "cue_id": "EP007-C05",
      "source_start_char": 30,
      "source_end_char": 39,
      "end_frame": 939
    },
    {
      "text": "清晨，",
      "display_text": "清晨",
      "start_frame": 946,
      "cue_id": "EP007-C06",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 966
    },
    {
      "text": "她猛地惊醒，抄起短棍，问我，",
      "display_text": "她猛地惊醒 抄起短棍 问我",
      "start_frame": 966,
      "cue_id": "EP007-C06",
      "source_start_char": 3,
      "source_end_char": 17,
      "end_frame": 1043
    },
    {
      "text": "我睡了多久？我说，六个小时。",
      "display_text": "我睡了多久 我说 六个小时",
      "start_frame": 1043,
      "cue_id": "EP007-C06",
      "source_start_char": 17,
      "source_end_char": 31,
      "end_frame": 1116
    },
    {
      "text": "她脸色很难看，说，退役以后，",
      "display_text": "她脸色很难看 说 退役以后",
      "start_frame": 1124,
      "cue_id": "EP007-C07",
      "source_start_char": 0,
      "source_end_char": 14,
      "end_frame": 1197
    },
    {
      "text": "我从来没连着睡过三个小时。",
      "display_text": "我从来没连着睡过三个小时",
      "start_frame": 1197,
      "cue_id": "EP007-C07",
      "source_start_char": 14,
      "source_end_char": 27,
      "end_frame": 1253
    },
    {
      "text": "我把热豆浆推到她面前，",
      "display_text": "我把热豆浆推到她面前",
      "start_frame": 1253,
      "cue_id": "EP007-C07",
      "source_start_char": 27,
      "source_end_char": 38,
      "end_frame": 1300
    },
    {
      "text": "她沉默地接了过去。",
      "display_text": "她沉默地接了过去",
      "start_frame": 1300,
      "cue_id": "EP007-C07",
      "source_start_char": 38,
      "source_end_char": 47,
      "end_frame": 1343
    },
    {
      "text": "升级条件，",
      "display_text": "升级条件",
      "start_frame": 1353,
      "cue_id": "EP007-C08",
      "source_start_char": 0,
      "source_end_char": 5,
      "end_frame": 1383
    },
    {
      "text": "五千物资点，",
      "display_text": "五千物资点",
      "start_frame": 1383,
      "cue_id": "EP007-C08",
      "source_start_char": 5,
      "source_end_char": 11,
      "end_frame": 1413
    },
    {
      "text": "二十安心值，刚好够。",
      "display_text": "二十安心值 刚好够",
      "start_frame": 1413,
      "cue_id": "EP007-C08",
      "source_start_char": 11,
      "source_end_char": 21,
      "end_frame": 1466
    },
    {
      "text": "我按下了确认。",
      "display_text": "我按下了确认",
      "start_frame": 1466,
      "cue_id": "EP007-C08",
      "source_start_char": 21,
      "source_end_char": 28,
      "end_frame": 1501
    },
    {
      "text": "脚下轻轻一震，",
      "display_text": "脚下轻轻一震",
      "start_frame": 1511,
      "cue_id": "EP007-C09",
      "source_start_char": 0,
      "source_end_char": 7,
      "end_frame": 1546
    },
    {
      "text": "白墙向外展开。厨房，浴室，四间卧室，",
      "display_text": "白墙向外展开 厨房 浴室 四间卧室",
      "start_frame": 1546,
      "cue_id": "EP007-C09",
      "source_start_char": 7,
      "source_end_char": 25,
      "end_frame": 1646
    },
    {
      "text": "木地板一块一块铺开。",
      "display_text": "木地板一块一块铺开",
      "start_frame": 1646,
      "cue_id": "EP007-C09",
      "source_start_char": 25,
      "source_end_char": 35,
      "end_frame": 1698
    },
    {
      "text": "夏凛站在原地，",
      "display_text": "夏凛站在原地",
      "start_frame": 1698,
      "cue_id": "EP007-C09",
      "source_start_char": 35,
      "source_end_char": 42,
      "end_frame": 1729
    },
    {
      "text": "短棍举起来，又放下。",
      "display_text": "短棍举起来 又放下",
      "start_frame": 1729,
      "cue_id": "EP007-C09",
      "source_start_char": 42,
      "source_end_char": 52,
      "end_frame": 1788
    },
    {
      "text": "我拧开浴室的龙头，",
      "display_text": "我拧开浴室的龙头",
      "start_frame": 1791,
      "cue_id": "EP007-C10",
      "source_start_char": 0,
      "source_end_char": 9,
      "end_frame": 1838
    },
    {
      "text": "热水冒着白气。",
      "display_text": "热水冒着白气",
      "start_frame": 1838,
      "cue_id": "EP007-C10",
      "source_start_char": 9,
      "source_end_char": 16,
      "end_frame": 1874
    },
    {
      "text": "末世前八十天，",
      "display_text": "末世前八十天",
      "start_frame": 1874,
      "cue_id": "EP007-C10",
      "source_start_char": 16,
      "source_end_char": 23,
      "end_frame": 1906
    },
    {
      "text": "我洗上了第一个热水澡，",
      "display_text": "我洗上了第一个热水澡",
      "start_frame": 1906,
      "cue_id": "EP007-C10",
      "source_start_char": 23,
      "source_end_char": 34,
      "end_frame": 1947
    },
    {
      "text": "忍不住唱了两句，破音。",
      "display_text": "忍不住唱了两句 破音",
      "start_frame": 1947,
      "cue_id": "EP007-C10",
      "source_start_char": 34,
      "source_end_char": 45,
      "end_frame": 1999
    },
    {
      "text": "门外，",
      "display_text": "门外",
      "start_frame": 2007,
      "cue_id": "EP007-C11",
      "source_start_char": 0,
      "source_end_char": 3,
      "end_frame": 2024
    },
    {
      "text": "夏凛抱着手臂。我听见她，",
      "display_text": "夏凛抱着手臂 我听见她",
      "start_frame": 2024,
      "cue_id": "EP007-C11",
      "source_start_char": 3,
      "source_end_char": 15,
      "end_frame": 2087
    },
    {
      "text": "很轻地笑了一声，",
      "display_text": "很轻地笑了一声",
      "start_frame": 2087,
      "cue_id": "EP007-C11",
      "source_start_char": 15,
      "source_end_char": 23,
      "end_frame": 2124
    },
    {
      "text": "又立刻压了下去。",
      "display_text": "又立刻压了下去",
      "start_frame": 2124,
      "cue_id": "EP007-C11",
      "source_start_char": 23,
      "source_end_char": 31,
      "end_frame": 2164
    },
    {
      "text": "出来以后，手机提示，下一级，",
      "display_text": "出来以后 手机提示 下一级",
      "start_frame": 2173,
      "cue_id": "EP007-C12",
      "source_start_char": 0,
      "source_end_char": 14,
      "end_frame": 2248
    },
    {
      "text": "需要安心值五百。屋里现在，",
      "display_text": "需要安心值五百 屋里现在",
      "start_frame": 2248,
      "cue_id": "EP007-C12",
      "source_start_char": 14,
      "source_end_char": 27,
      "end_frame": 2299
    },
    {
      "text": "只有一位住客。",
      "display_text": "只有一位住客",
      "start_frame": 2299,
      "cue_id": "EP007-C12",
      "source_start_char": 27,
      "source_end_char": 34,
      "end_frame": 2341
    },
    {
      "text": "我擦着头发说，",
      "display_text": "我擦着头发说",
      "start_frame": 2348,
      "cue_id": "EP007-C13",
      "source_start_char": 0,
      "source_end_char": 7,
      "end_frame": 2384
    },
    {
      "text": "我得找更多人。夏凛问，找谁？我说，",
      "display_text": "我得找更多人 夏凛问 找谁 我说",
      "start_frame": 2384,
      "cue_id": "EP007-C13",
      "source_start_char": 7,
      "source_end_char": 24,
      "end_frame": 2472
    },
    {
      "text": "能让这间屋，住满的人。",
      "display_text": "能让这间屋 住满的人",
      "start_frame": 2472,
      "cue_id": "EP007-C13",
      "source_start_char": 24,
      "source_end_char": 35,
      "end_frame": 2519
    },
    {
      "text": "我低头，",
      "display_text": "我低头",
      "start_frame": 2522,
      "cue_id": "EP007-C14",
      "source_start_char": 0,
      "source_end_char": 4,
      "end_frame": 2543
    },
    {
      "text": "看着角落里那个空医疗箱。水，粮，灯，",
      "display_text": "看着角落里那个空医疗箱 水 粮 灯",
      "start_frame": 2543,
      "cue_id": "EP007-C14",
      "source_start_char": 4,
      "source_end_char": 22,
      "end_frame": 2645
    },
    {
      "text": "都有了，",
      "display_text": "都有了",
      "start_frame": 2645,
      "cue_id": "EP007-C14",
      "source_start_char": 22,
      "source_end_char": 26,
      "end_frame": 2672
    },
    {
      "text": "唯独缺一个，",
      "display_text": "唯独缺一个",
      "start_frame": 2672,
      "cue_id": "EP007-C14",
      "source_start_char": 26,
      "source_end_char": 32,
      "end_frame": 2694
    },
    {
      "text": "会用它的人。",
      "display_text": "会用它的人",
      "start_frame": 2694,
      "cue_id": "EP007-C14",
      "source_start_char": 32,
      "source_end_char": 38,
      "end_frame": 2729
    }
