  "subtitles": [
    [
      0.0,
      4.233333333333333,
      "店长回来了，手里还拿着备用钥匙。"
    ],
    [
      4.233333333333333,
      8.866666666666667,
      "我刚想开门，忽然看见他一直捂着胳膊。"
    ],
    [
      8.866666666666667,
      13.1,
      "我隔着对讲机，让他把袖子卷起来。"
    ],
    [
      13.1,
      15.0,
      "他没有动。"
    ],
    [
      15.0,
      20.266666666666666,
      "他说只是摔了一跤，还让我别忘了谁给我发工资。"
    ],
    [
      20.266666666666666,
      23.7,
      "可他一抬手，袖口滑下去了。"
    ],
    [
      23.7,
      27.166666666666668,
      "小臂上，清清楚楚一圈牙印。"
    ],
    [
      27.166666666666668,
      30.0,
      "我把手从按钮上拿开。"
    ],
    [
      30.0,
      33.36666666666667,
      "我先扣死了门内的插销。"
    ],
    [
      33.36666666666667,
      38.3,
      "钥匙能打开外锁，却抽不开里面这道闩。"
    ],
    [
      38.3,
      40.733333333333334,
      "他骂了我很久。"
    ],
    [
      40.733333333333334,
      45.0,
      "我坐在监控前，始终没碰开门键。"
    ],
    [
      45.0,
      47.36666666666667,
      "后来，骂声停了。"
    ],
    [
      47.36666666666667,
      52.5,
      "他不再抬头看摄像头，开始用额头一下一下撞门。"
    ],
    [
      52.5,
      55.666666666666664,
      "那一刻，我后背全是冷汗。"
    ],
    [
      55.666666666666664,
      60.0,
      "刚才只要再快一点，我就把他放进来了。"
    ]
  ]
}
