  "subtitles": [
    [
      0.0,
      3.2666666666666666,
      "我没有开门，让她先站远一点。"
    ],
    [
      3.2666666666666666,
      6.133333333333334,
      "她叫许棠，是来修冷库的。"
    ],
    [
      6.133333333333334,
      11.2,
      "昨晚取工具时外面出了事，\n她躲回维修车，没敢下来。"
    ],
    [
      11.2,
      15.0,
      "她举起的工单，和店里的记录对得上。"
    ],
    [
      15.0,
      19.3,
      "我正想问她有没有受伤，冷库先报警了。"
    ],
    [
      19.3,
      23.166666666666668,
      "她听见动静，让我看装卸区的外机。"
    ],
    [
      23.166666666666668,
      26.3,
      "散热口前，倒着一堆纸箱。"
    ],
    [
      26.3,
      30.0,
      "她放下工具包，先把纸箱挪开了。"
    ],
    [
      30.0,
      34.5,
      "我照着她的说明，看温控屏上的变化。"
    ],
    [
      34.5,
      38.13333333333333,
      "十几分钟后，报警灯才熄了。"
    ],
    [
      38.13333333333333,
      40.93333333333333,
      "她确实懂这套设备。"
    ],
    [
      40.93333333333333,
      45.0,
      "可我还是没有立刻打开卖场的门。"
    ],
    [
      45.0,
      49.5,
      "她看见我犹豫，指了指两道门之间的收货间。"
    ],
    [
      49.5,
      54.2,
      "她说，先让她待在那里，水和吃的放进去就行。"
    ],
    [
      54.2,
      57.93333333333333,
      "等我愿意相信她，再开里面那道门。"
    ],
    [
      57.93333333333333,
      60.0,
      "她连床都没要。"
    ]
  ]
}
