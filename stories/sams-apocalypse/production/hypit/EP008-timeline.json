  "subtitles": [
    [
      0.0,
      4.066666666666666,
      "第四天晚上，整座山姆突然黑了。"
    ],
    [
      4.066666666666666,
      6.866666666666666,
      "我第一反应是冷库。"
    ],
    [
      6.866666666666666,
      11.566666666666666,
      "许棠已经戴上头灯，先让我别开冷库门。"
    ],
    [
      11.566666666666666,
      15.0,
      "窗外，整条街的灯也灭了。"
    ],
    [
      15.0,
      20.533333333333335,
      "我们按事先列好的清单，\n保留监控、通信和一间冷库。"
    ],
    [
      20.533333333333335,
      23.1,
      "备用发电机启动了。"
    ],
    [
      23.1,
      27.033333333333335,
      "灯重新亮起来时，我刚松了一口气。"
    ],
    [
      27.033333333333335,
      30.0,
      "许棠却让我去看停车场。"
    ],
    [
      30.0,
      33.96666666666667,
      "刚才还散着的人影，正往设备间这边走。"
    ],
    [
      33.96666666666667,
      38.3,
      "城市安静下来以后，机器的声音传得格外远。"
    ],
    [
      38.3,
      41.4,
      "我们有吃的，有水，也有油。"
    ],
    [
      41.4,
      45.0,
      "可每用一会儿电，门外就多几张脸。"
    ],
    [
      45.0,
      49.56666666666667,
      "我把用电清单摊在桌上，许棠把冷库记录放到旁边。"
    ],
    [
      49.56666666666667,
      54.266666666666666,
      "我们得重新安排机器的运行，\n既省油，也少暴露自己。"
    ],
    [
      54.266666666666666,
      56.13333333333333,
      "我抬头看监控。"
    ],
    [
      56.13333333333333,
      60.0,
      "停车场最远处，又有一片人影转向了我们。"
    ]
  ]
}
