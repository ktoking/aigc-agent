  "subtitles": [
    [
      0.0,
      4.8,
      "我把水、面包、被子和便携厕所放进收货间。"
    ],
    [
      4.8,
      8.4,
      "关好内门，才让她从外面进来。"
    ],
    [
      8.4,
      11.2,
      "她主动留在那里观察。"
    ],
    [
      11.2,
      15.0,
      "我们之间，隔着一道带玻璃的门。"
    ],
    [
      15.0,
      19.033333333333335,
      "晚上，我把盘好的物资清单贴给她看。"
    ],
    [
      19.033333333333335,
      23.833333333333332,
      "她看完，把纸巾、垃圾袋和备用照明补了上去。"
    ],
    [
      23.833333333333332,
      26.333333333333332,
      "我惦记着能吃什么。"
    ],
    [
      26.333333333333332,
      30.0,
      "她惦记着，吃完以后怎么过日子。"
    ],
    [
      30.0,
      32.93333333333333,
      "我熟悉货架，她熟悉设备。"
    ],
    [
      32.93333333333333,
      38.766666666666666,
      "我把安全区和通道标给她，\n她给我圈出了冷库和备用电的位置。"
    ],
    [
      38.766666666666666,
      41.9,
      "整整一夜，我们都没怎么睡。"
    ],
    [
      41.9,
      45.0,
      "那道门，却谁也没催着打开。"
    ],
    [
      45.0,
      48.13333333333333,
      "天亮时，我在椅子上睡醒了。"
    ],
    [
      48.13333333333333,
      53.13333333333333,
      "隔着玻璃，她也靠着墙睡着了，工具包还抱在怀里。"
    ],
    [
      53.13333333333333,
      55.56666666666667,
      "我轻轻敲了一下窗。"
    ],
    [
      55.56666666666667,
      60.0,
      "她睁开眼，我忽然觉得，今天没那么难熬了。"
    ]
  ]
