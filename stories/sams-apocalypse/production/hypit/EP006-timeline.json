  "subtitles": [
    [
      0.0,
      3.7,
      "第二天傍晚，她在收货间待满了一天。"
    ],
    [
      3.7,
      7.066666666666666,
      "没有发现咬伤，精神也一直清醒。"
    ],
    [
      7.066666666666666,
      11.3,
      "我们再次核对完昨晚的经过，我打开了内门。"
    ],
    [
      11.3,
      15.0,
      "她进来后，先把空水瓶放进了回收袋。"
    ],
    [
      15.0,
      20.0,
      "我挑了两块快到期的牛排，又洗了一大碗草莓。"
    ],
    [
      20.0,
      23.2,
      "她看着锅，问我会不会煎。"
    ],
    [
      23.2,
      25.8,
      "我说，包装上写着。"
    ],
    [
      25.8,
      30.0,
      "她接过夹子，把快糊的那块翻了个面。"
    ],
    [
      30.0,
      33.9,
      "这是出事后，我第一次和人坐着吃饭。"
    ],
    [
      33.9,
      36.666666666666664,
      "她问我，明天想做什么。"
    ],
    [
      36.666666666666664,
      42.233333333333334,
      "我说，把旁边的休息室收拾出来，\n再把剩下的货架清一遍。"
    ],
    [
      42.233333333333334,
      45.0,
      "她点点头，说设备归她。"
    ],
    [
      45.0,
      49.0,
      "吃完，我把监控室的备用钥匙放在她碗边。"
    ],
    [
      49.0,
      51.96666666666667,
      "她没急着拿，先看了我一眼。"
    ],
    [
      51.96666666666667,
      55.63333333333333,
      "我说，今晚我值前半夜，后半夜换你。"
    ],
    [
      55.63333333333333,
      60.0,
      "她这才收起钥匙，把最后一块牛角包分给了我。"
    ]
  ]
}
