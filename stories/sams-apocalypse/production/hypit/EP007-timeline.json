  "subtitles": [
    [
      0.0,
      4.766666666666667,
      "第三天，我负责盘货、搬东西，许棠负责查设备。"
    ],
    [
      4.766666666666667,
      8.966666666666667,
      "监控室旁边的休息室，被我们收拾了出来。"
    ],
    [
      8.966666666666667,
      11.166666666666666,
      "她有了自己的床。"
    ],
    [
      11.166666666666666,
      15.0,
      "我的被子，也终于不用总铺在椅子上。"
    ],
    [
      15.0,
      19.133333333333333,
      "水和清洁用品分开，常温粮和临期食品分开。"
    ],
    [
      19.133333333333333,
      22.766666666666666,
      "吃剩的包装及时收走，通道一直留空。"
    ],
    [
      22.766666666666666,
      25.866666666666667,
      "我们还清出了备用电的设备间。"
    ],
    [
      25.866666666666667,
      30.0,
      "油箱里有油，但能撑多久，得看我们怎么用。"
    ],
    [
      30.0,
      35.5,
      "每天晚上，我们先定第二天吃什么，\n再定第二天做什么。"
    ],
    [
      35.5,
      37.96666666666667,
      "她喝热牛奶不放糖。"
    ],
    [
      37.96666666666667,
      40.63333333333333,
      "我总想多拿一袋肉干。"
    ],
    [
      40.63333333333333,
      45.0,
      "她不拦我，只让我吃完记得在清单上减掉。"
    ],
    [
      45.0,
      49.233333333333334,
      "半夜交班，她把温好的牛奶放在了桌上。"
    ],
    [
      49.233333333333334,
      52.9,
      "我第一次放心地关上休息室的门。"
    ],
    [
      52.9,
      55.2,
      "外面仍然有丧尸。"
    ],
    [
      55.2,
      60.0,
      "可我睡着的时候，终于有人替我看着那扇门了。"
    ]
  ]
