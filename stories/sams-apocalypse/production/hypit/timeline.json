  "subtitles": [
    [0,4,"丧尸爆发后，我住进了整座山姆。"],
    [4,7,"昨天，我还在这里搬货。"],
    [7,11.5,"今天，货架上的东西，我随便拿。"],
    [11.5,15,"事情得从昨晚说起。"],
    [15,18,"闭店后，同事们突然往外跑。"],
    [18,23,"我追到监控前，\n看见停车场里有人扑倒了店长。"],
    [23,26.5,"我立刻关下卸货区的卷帘门。"],
    [26.5,30,"在监控室里，躲了一夜。"],
    [30,33,"天亮，外面还在砸门。"],
    [33,37,"我身后却是整排饮用水、成箱罐头。"],
    [37,39.5,"冷库还在运转。"],
    [39.5,43.5,"以前舍不得买的牛肉干和坚果，\n我装了满满一车。"],
    [43.5,45,"第一次，没看价签。"],
    [45,49,"我把露营床搬进监控室，铺好被子。"],
    [49,53,"刚坐下，卸货门外就多了一个人。"],
    [53,55,"我放大画面。"],
    [55,56.5,"是店长。"],
    [56.5,60,"他手里，攥着备用钥匙。"]
  ]
}
