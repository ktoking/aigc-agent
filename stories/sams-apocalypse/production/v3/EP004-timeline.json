  "cues": [
    {
      "index": 1,
      "segment": 1,
      "text": "我没有开门，让她先站远一点。",
      "characters": 12,
      "start_frame": 0,
      "end_frame_exclusive": 72,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 2,
      "segment": 1,
      "text": "她叫许棠，是来修冷库的。",
      "characters": 10,
      "start_frame": 72,
      "end_frame_exclusive": 132,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 3,
      "segment": 1,
      "text": "昨晚取工具时外面出了事，她躲回维修车，没敢下来。",
      "characters": 21,
      "start_frame": 132,
      "end_frame_exclusive": 258,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 4,
      "segment": 1,
      "text": "她举起的工单，和店里的记录对得上。",
      "characters": 15,
      "start_frame": 258,
      "end_frame_exclusive": 348,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 5,
      "segment": 2,
      "text": "我正想问她有没有受伤，冷库先报警了。",
      "characters": 16,
      "start_frame": 348,
      "end_frame_exclusive": 444,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 6,
      "segment": 2,
      "text": "她听见动静，让我看装卸区的外机。",
      "characters": 14,
      "start_frame": 444,
      "end_frame_exclusive": 528,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 7,
      "segment": 2,
      "text": "散热口前，倒着一堆纸箱。",
      "characters": 10,
      "start_frame": 528,
      "end_frame_exclusive": 588,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 8,
      "segment": 2,
      "text": "她放下工具包，先把纸箱挪开了。",
      "characters": 13,
      "start_frame": 588,
      "end_frame_exclusive": 666,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 9,
      "segment": 3,
      "text": "我照着她的说明，看温控屏上的变化。",
      "characters": 15,
      "start_frame": 666,
      "end_frame_exclusive": 756,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 10,
      "segment": 3,
      "text": "十几分钟后，报警灯才熄了。",
      "characters": 11,
      "start_frame": 756,
      "end_frame_exclusive": 822,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 11,
      "segment": 3,
      "text": "她确实懂这套设备。",
      "characters": 8,
      "start_frame": 822,
      "end_frame_exclusive": 870,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 12,
      "segment": 3,
      "text": "可我还是没有立刻打开卖场的门。",
      "characters": 14,
      "start_frame": 870,
      "end_frame_exclusive": 954,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 13,
      "segment": 4,
      "text": "她看见我犹豫，指了指两道门之间的收货间。",
      "characters": 18,
      "start_frame": 954,
      "end_frame_exclusive": 1062,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 14,
      "segment": 4,
      "text": "她说，先让她待在那里，水和吃的放进去就行。",
      "characters": 18,
      "start_frame": 1062,
      "end_frame_exclusive": 1170,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 15,
      "segment": 4,
      "text": "等我愿意相信她，再开里面那道门。",
      "characters": 14,
      "start_frame": 1170,
      "end_frame_exclusive": 1254,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 16,
      "segment": 4,
      "text": "她连床都没要。",
      "characters": 6,
      "start_frame": 1254,
      "end_frame_exclusive": 1290,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    }
  ],
