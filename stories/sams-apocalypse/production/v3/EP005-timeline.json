  "cues": [
    {
      "index": 1,
      "segment": 1,
      "text": "我把水、面包、被子和便携厕所放进收货间。",
      "characters": 17,
      "start_frame": 0,
      "end_frame_exclusive": 102,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 2,
      "segment": 1,
      "text": "关好内门，才让她从外面进来。",
      "characters": 12,
      "start_frame": 102,
      "end_frame_exclusive": 174,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 3,
      "segment": 1,
      "text": "她主动留在那里观察。",
      "characters": 9,
      "start_frame": 174,
      "end_frame_exclusive": 228,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 4,
      "segment": 1,
      "text": "我们之间，隔着一道带玻璃的门。",
      "characters": 13,
      "start_frame": 228,
      "end_frame_exclusive": 306,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 5,
      "segment": 2,
      "text": "晚上，我把盘好的物资清单贴给她看。",
      "characters": 15,
      "start_frame": 306,
      "end_frame_exclusive": 396,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 6,
      "segment": 2,
      "text": "她看完，把纸巾、垃圾袋和备用照明补了上去。",
      "characters": 18,
      "start_frame": 396,
      "end_frame_exclusive": 504,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 7,
      "segment": 2,
      "text": "我惦记着能吃什么。",
      "characters": 8,
      "start_frame": 504,
      "end_frame_exclusive": 552,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 8,
      "segment": 2,
      "text": "她惦记着，吃完以后怎么过日子。",
      "characters": 13,
      "start_frame": 552,
      "end_frame_exclusive": 630,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 9,
      "segment": 3,
      "text": "我熟悉货架，她熟悉设备。",
      "characters": 10,
      "start_frame": 630,
      "end_frame_exclusive": 690,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 10,
      "segment": 3,
      "text": "我把安全区和通道标给她，她给我圈出了冷库和备用电的位置。",
      "characters": 26,
      "start_frame": 690,
      "end_frame_exclusive": 846,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 11,
      "segment": 3,
      "text": "整整一夜，我们都没怎么睡。",
      "characters": 11,
      "start_frame": 846,
      "end_frame_exclusive": 912,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 12,
      "segment": 3,
      "text": "那道门，却谁也没催着打开。",
      "characters": 11,
      "start_frame": 912,
      "end_frame_exclusive": 978,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 13,
      "segment": 4,
      "text": "天亮时，我在椅子上睡醒了。",
      "characters": 11,
      "start_frame": 978,
      "end_frame_exclusive": 1044,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 14,
      "segment": 4,
      "text": "隔着玻璃，她也靠着墙睡着了，工具包还抱在怀里。",
      "characters": 20,
      "start_frame": 1044,
      "end_frame_exclusive": 1164,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 15,
      "segment": 4,
      "text": "我轻轻敲了一下窗。",
      "characters": 8,
      "start_frame": 1164,
      "end_frame_exclusive": 1212,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 16,
      "segment": 4,
      "text": "她睁开眼，我忽然觉得，今天没那么难熬了。",
      "characters": 17,
      "start_frame": 1212,
      "end_frame_exclusive": 1314,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    }
  ],
