  "cues": [
    {
      "index": 1,
      "segment": 1,
      "text": "丧尸爆发后，我住进了整座山姆。",
      "characters": 13,
      "start_frame": 0,
      "end_frame_exclusive": 78,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 2,
      "segment": 1,
      "text": "昨天，我还在这里搬货。",
      "characters": 9,
      "start_frame": 78,
      "end_frame_exclusive": 132,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 3,
      "segment": 1,
      "text": "今天，货架上的东西，我随便拿。",
      "characters": 12,
      "start_frame": 132,
      "end_frame_exclusive": 204,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 4,
      "segment": 1,
      "text": "事情得从昨晚说起。",
      "characters": 8,
      "start_frame": 204,
      "end_frame_exclusive": 252,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 5,
      "segment": 2,
      "text": "闭店后，同事们突然往外跑。",
      "characters": 11,
      "start_frame": 252,
      "end_frame_exclusive": 318,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 6,
      "segment": 2,
      "text": "我追到监控前，看见停车场里有人扑倒了店长。",
      "characters": 19,
      "start_frame": 318,
      "end_frame_exclusive": 432,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 7,
      "segment": 2,
      "text": "我立刻关下卸货区的卷帘门。",
      "characters": 12,
      "start_frame": 432,
      "end_frame_exclusive": 504,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 8,
      "segment": 2,
      "text": "在监控室里，躲了一夜。",
      "characters": 9,
      "start_frame": 504,
      "end_frame_exclusive": 558,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 9,
      "segment": 3,
      "text": "天亮，外面还在砸门。",
      "characters": 8,
      "start_frame": 558,
      "end_frame_exclusive": 606,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 10,
      "segment": 3,
      "text": "我身后却是整排饮用水、成箱罐头。",
      "characters": 14,
      "start_frame": 606,
      "end_frame_exclusive": 690,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 11,
      "segment": 3,
      "text": "冷库还在运转。",
      "characters": 6,
      "start_frame": 690,
      "end_frame_exclusive": 726,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 12,
      "segment": 3,
      "text": "以前舍不得买的牛肉干和坚果，我装了满满一车。",
      "characters": 20,
      "start_frame": 726,
      "end_frame_exclusive": 846,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 13,
      "segment": 3,
      "text": "第一次，没看价签。",
      "characters": 7,
      "start_frame": 846,
      "end_frame_exclusive": 888,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 14,
      "segment": 4,
      "text": "我把露营床搬进监控室，铺好被子。",
      "characters": 14,
      "start_frame": 888,
      "end_frame_exclusive": 972,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 15,
      "segment": 4,
      "text": "刚坐下，卸货门外就多了一个人。",
      "characters": 13,
      "start_frame": 972,
      "end_frame_exclusive": 1050,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 16,
      "segment": 4,
      "text": "我放大画面。",
      "characters": 5,
      "start_frame": 1050,
      "end_frame_exclusive": 1080,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 17,
      "segment": 4,
      "text": "是店长。",
      "characters": 3,
      "start_frame": 1080,
      "end_frame_exclusive": 1098,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 18,
      "segment": 4,
      "text": "他手里，攥着备用钥匙。",
      "characters": 9,
      "start_frame": 1098,
      "end_frame_exclusive": 1152,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    }
  ],
