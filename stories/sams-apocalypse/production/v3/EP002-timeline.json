  ],
  "cues": [
    {
      "index": 1,
      "segment": 1,
      "text": "店长回来了，手里还拿着备用钥匙。",
      "characters": 14,
      "start_frame": 0,
      "end_frame_exclusive": 84,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 2,
      "segment": 1,
      "text": "我刚想开门，忽然看见他一直捂着胳膊。",
      "characters": 16,
      "start_frame": 84,
      "end_frame_exclusive": 180,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 3,
      "segment": 1,
      "text": "我隔着对讲机，让他把袖子卷起来。",
      "characters": 14,
      "start_frame": 180,
      "end_frame_exclusive": 264,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 4,
      "segment": 1,
      "text": "他没有动。",
      "characters": 4,
      "start_frame": 264,
      "end_frame_exclusive": 288,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 5,
      "segment": 2,
      "text": "他说只是摔了一跤，还让我别忘了谁给我发工资。",
      "characters": 20,
      "start_frame": 288,
      "end_frame_exclusive": 408,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 6,
      "segment": 2,
      "text": "可他一抬手，袖口滑下去了。",
      "characters": 11,
      "start_frame": 408,
      "end_frame_exclusive": 474,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 7,
      "segment": 2,
      "text": "小臂上，清清楚楚一圈牙印。",
      "characters": 11,
      "start_frame": 474,
      "end_frame_exclusive": 540,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 8,
      "segment": 2,
      "text": "我把手从按钮上拿开。",
      "characters": 9,
      "start_frame": 540,
      "end_frame_exclusive": 594,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 9,
      "segment": 3,
      "text": "我先扣死了门内的插销。",
      "characters": 10,
      "start_frame": 594,
      "end_frame_exclusive": 654,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 10,
      "segment": 3,
      "text": "钥匙能打开外锁，却抽不开里面这道闩。",
      "characters": 16,
      "start_frame": 654,
      "end_frame_exclusive": 750,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 11,
      "segment": 3,
      "text": "他骂了我很久。",
      "characters": 6,
      "start_frame": 750,
      "end_frame_exclusive": 786,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 12,
      "segment": 3,
      "text": "我坐在监控前，始终没碰开门键。",
      "characters": 13,
      "start_frame": 786,
      "end_frame_exclusive": 864,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 13,
      "segment": 4,
      "text": "后来，骂声停了。",
      "characters": 6,
      "start_frame": 864,
      "end_frame_exclusive": 900,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 14,
      "segment": 4,
      "text": "他不再抬头看摄像头，开始用额头一下一下撞门。",
      "characters": 20,
      "start_frame": 900,
      "end_frame_exclusive": 1020,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 15,
      "segment": 4,
      "text": "那一刻，我后背全是冷汗。",
      "characters": 10,
      "start_frame": 1020,
      "end_frame_exclusive": 1080,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    },
    {
      "index": 16,
      "segment": 4,
      "text": "刚才只要再快一点，我就把他放进来了。",
      "characters": 16,
      "start_frame": 1080,
      "end_frame_exclusive": 1176,
      "gap_after_frames": 0,
      "timing_basis": "text_estimate_not_audio_aligned"
    }
  ],
