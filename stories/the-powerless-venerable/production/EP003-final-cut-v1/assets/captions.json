[
  {
    "start": 2.12,
    "end": 3.22,
    "text": "我穿越了",
    "kind": "self_introduction"
  },
  {
    "start": 3.22,
    "end": 5.05,
    "text": "成了修仙界的镇宗大尊者",
    "kind": "self_introduction"
  },
  {
    "start": 5.52,
    "end": 7.09,
    "text": "可我半点仙力都没有啊！",
    "kind": "self_introduction"
  },
  {
    "start": 9.69,
    "end": 11.12,
    "source_id": 1,
    "segment": 1,
    "local_start": 2.29,
    "local_end": 3.72,
    "text": "怎么都看着我？",
    "image": "assets/captions/001.png"
  },
  {
    "start": 11.59,
    "end": 13.28,
    "source_id": 1,
    "segment": 1,
    "local_start": 4.19,
    "local_end": 5.88,
    "text": "裴道友……在等什么？",
    "image": "assets/captions/002.png"
  },
  {
    "start": 13.53,
    "end": 15.29,
    "source_id": 1,
    "segment": 1,
    "local_start": 6.13,
    "local_end": 7.89,
    "text": "方才老夫以传音相请",
    "image": "assets/captions/003.png"
  },
  {
    "start": 15.35,
    "end": 16.58,
    "source_id": 1,
    "segment": 1,
    "local_start": 7.95,
    "local_end": 9.18,
    "text": "正等道友答复。",
    "image": "assets/captions/004.png"
  },
  {
    "start": 16.79,
    "end": 19.48,
    "source_id": 1,
    "segment": 1,
    "local_start": 9.39,
    "local_end": 12.08,
    "text": "还请道友登坛，为会盟开讲。",
    "image": "assets/captions/005.png"
  },
  {
    "start": 22.5,
    "end": 24.76,
    "source_id": 2,
    "segment": 2,
    "local_start": 0,
    "local_end": 2.26,
    "text": "天衡十年一度至尊讲道",
    "image": "assets/captions/006.png"
  },
  {
    "start": 24.92,
    "end": 26.79,
    "source_id": 2,
    "segment": 2,
    "local_start": 2.42,
    "local_end": 4.29,
    "text": "恭请谢尊者开坛！",
    "image": "assets/captions/007.png"
  },
  {
    "start": 27.98,
    "end": 29.97,
    "source_id": 2,
    "segment": 2,
    "local_start": 5.48,
    "local_end": 7.47,
    "text": "敢问至尊，何谓筑基？",
    "image": "assets/captions/008.png"
  },
  {
    "start": 30.78,
    "end": 32.1,
    "source_id": 2,
    "segment": 2,
    "local_start": 8.28,
    "local_end": 9.6,
    "text": "筑基是啥啊？",
    "image": "assets/captions/009.png"
  },
  {
    "start": 32.7,
    "end": 34.7,
    "source_id": 2,
    "segment": 2,
    "local_start": 10.2,
    "local_end": 12.2,
    "text": "我连修仙入门都没学过！",
    "image": "assets/captions/010.png"
  },
  {
    "start": 44.37,
    "end": 46.39,
    "source_id": 4,
    "segment": 3,
    "local_start": 6.77,
    "local_end": 8.79,
    "text": "已过一个时辰",
    "image": "assets/captions/011.png"
  },
  {
    "start": 46.39,
    "end": 48.49,
    "source_id": 4,
    "segment": 3,
    "local_start": 8.79,
    "local_end": 10.89,
    "text": "至尊竟未发一言。",
    "image": "assets/captions/012.png"
  },
  {
    "start": 48.77,
    "end": 52.26,
    "source_id": 4,
    "segment": 3,
    "local_start": 11.17,
    "local_end": 14.66,
    "text": "你们倒是下课啊，我腿都麻了。",
    "image": "assets/captions/013.png"
  },
  {
    "start": 54.03,
    "end": 55.76,
    "source_id": 3,
    "segment": 4,
    "local_start": 1.33,
    "local_end": 3.06,
    "text": "不愧是至尊！",
    "image": "assets/captions/014.png"
  },
  {
    "start": 56.11,
    "end": 58.64,
    "source_id": 3,
    "segment": 4,
    "local_start": 3.41,
    "local_end": 5.94,
    "text": "大道无言，万法皆空！",
    "image": "assets/captions/015.png"
  },
  {
    "start": 59.37,
    "end": 60.56,
    "source_id": 3,
    "segment": 4,
    "local_start": 6.67,
    "local_end": 7.86,
    "text": "弟子悟了！",
    "image": "assets/captions/016.png"
  },
  {
    "start": 60.93,
    "end": 62.09,
    "source_id": 3,
    "segment": 4,
    "local_start": 8.23,
    "local_end": 9.39,
    "text": "我也悟了！",
    "image": "assets/captions/017.png"
  },
  {
    "start": 62.13,
    "end": 63.88,
    "source_id": 3,
    "segment": 4,
    "local_start": 9.43,
    "local_end": 11.18,
    "text": "弟子也悟了！",
    "image": "assets/captions/018.png"
  },
  {
    "start": 63.91,
    "end": 66.49,
    "source_id": 3,
    "segment": 4,
    "local_start": 11.21,
    "local_end": 13.79,
    "text": "我一句没说，你们到底悟了个啥？",
    "image": "assets/captions/019.png"
  }
]
