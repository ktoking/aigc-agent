[
  {
    "start": 2.12,
    "end": 3.22,
    "text": "我穿越了",
    "kind": "self_introduction"
  },
  {
    "start": 3.22,
    "end": 5.05,
    "text": "成了修仙界的镇宗大尊者",
    "kind": "self_introduction"
  },
  {
    "start": 5.52,
    "end": 7.09,
    "text": "可我半点仙力都没有啊！",
    "kind": "self_introduction"
  },
  {
    "start": 9.5,
    "end": 11.22,
    "source_id": 5,
    "segment": 1,
    "local_start": 2.1,
    "local_end": 3.82,
    "text": "现在先给我来顿火锅",
    "image": "assets/captions/001.png"
  },
  {
    "start": 11.22,
    "end": 13.44,
    "source_id": 5,
    "segment": 1,
    "local_start": 3.82,
    "local_end": 6.04,
    "text": "涮点肉，什么都好说。",
    "image": "assets/captions/002.png"
  },
  {
    "start": 13.44,
    "end": 16.32,
    "source_id": 5,
    "segment": 1,
    "local_start": 6.04,
    "local_end": 8.92,
    "text": "本座……想吃点东西。",
    "image": "assets/captions/003.png"
  },
  {
    "start": 16.32,
    "end": 19.11,
    "source_id": 5,
    "segment": 1,
    "local_start": 8.92,
    "local_end": 11.71,
    "text": "仙膳已备，至尊请稍候。",
    "image": "assets/captions/004.png"
  },
  {
    "start": 19.5,
    "end": 20.85,
    "source_id": 5,
    "segment": 1,
    "local_start": 12.1,
    "local_end": 13.45,
    "text": "至尊，膳食到了。",
    "image": "assets/captions/005.png"
  },
  {
    "start": 22.5,
    "end": 26.67,
    "source_id": 6,
    "segment": 2,
    "local_start": 0,
    "local_end": 4.17,
    "text": "九转龙髓丹，专为至尊备下。",
    "image": "assets/captions/006.png"
  },
  {
    "start": 26.78,
    "end": 28.24,
    "source_id": 6,
    "segment": 2,
    "local_start": 4.28,
    "local_end": 5.74,
    "text": "我要吃火锅啊。",
    "image": "assets/captions/007.png"
  },
  {
    "start": 32.25,
    "end": 34.25,
    "source_id": 6,
    "segment": 2,
    "local_start": 9.75,
    "local_end": 11.75,
    "text": "苦成这样，这怎么下饭？",
    "image": "assets/captions/008.png"
  },
  {
    "start": 34.51,
    "end": 36.08,
    "source_id": 6,
    "segment": 2,
    "local_start": 12.01,
    "local_end": 13.58,
    "text": "我再去取些仙露。",
    "image": "assets/captions/009.png"
  },
  {
    "start": 37.9,
    "end": 40.89,
    "source_id": 7,
    "segment": 3,
    "local_start": 0.3,
    "local_end": 3.29,
    "text": "劳烦，偷偷给我煮碗面，清汤的。",
    "image": "assets/captions/010.png"
  },
  {
    "start": 41.22,
    "end": 42.22,
    "source_id": 7,
    "segment": 3,
    "local_start": 3.62,
    "local_end": 4.62,
    "text": "您要吃面？",
    "image": "assets/captions/011.png"
  },
  {
    "start": 42.92,
    "end": 45.01,
    "source_id": 7,
    "segment": 3,
    "local_start": 5.32,
    "local_end": 7.41,
    "text": "对，卧个鸡蛋，快一点。",
    "image": "assets/captions/012.png"
  },
  {
    "start": 46.04,
    "end": 47.29,
    "source_id": 7,
    "segment": 3,
    "local_start": 8.44,
    "local_end": 9.69,
    "text": "好，马上就来。",
    "image": "assets/captions/013.png"
  },
  {
    "start": 53.42,
    "end": 56.93,
    "source_id": 8,
    "segment": 4,
    "local_start": 0.72,
    "local_end": 4.23,
    "text": "至尊竟舍弃仙丹，只食五谷！",
    "image": "assets/captions/014.png"
  },
  {
    "start": 57.26,
    "end": 60.55,
    "source_id": 8,
    "segment": 4,
    "local_start": 4.56,
    "local_end": 7.85,
    "text": "莫非这是斩断仙道执念的最后一步？",
    "image": "assets/captions/015.png"
  },
  {
    "start": 61.28,
    "end": 63.45,
    "source_id": 8,
    "segment": 4,
    "local_start": 8.58,
    "local_end": 10.75,
    "text": "传令，仙宴改素面！",
    "image": "assets/captions/016.png"
  },
  {
    "start": 64.48,
    "end": 67.6,
    "source_id": 8,
    "segment": 4,
    "local_start": 11.78,
    "local_end": 14.9,
    "text": "我就吃碗面，怎么还把肉吃没了？",
    "image": "assets/captions/017.png"
  }
]
