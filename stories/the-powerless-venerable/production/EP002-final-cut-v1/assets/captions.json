  },
  {
    "id": 5,
    "segment": 1,
    "local_start": 4.2,
    "local_end": 5.08,
    "start": 11.6,
    "end": 12.48,
    "text": "怎么办？",
    "image": "assets/captions/002.png"
  },
  {
    "id": 6,
    "segment": 1,
    "local_start": 5.28,
    "local_end": 6.57,
    "start": 12.68,
    "end": 13.97,
    "text": "嘴也不听使唤了！",
    "image": "assets/captions/003.png"
  },
  {
    "id": 7,
    "segment": 1,
    "local_start": 6.9,
    "local_end": 8.4,
    "start": 14.3,
    "end": 15.8,
    "text": "本……我……",
    "image": "assets/captions/004.png"
  },
  {
    "id": 8,
    "segment": 1,
    "local_start": 8.46,
    "local_end": 9.08,
    "start": 15.86,
    "end": 16.48,
    "text": "快撤！",
    "image": "assets/captions/005.png"
  },
  {
    "id": 9,
    "segment": 1,
    "local_start": 9.18,
    "local_end": 10.22,
    "start": 16.58,
    "end": 17.62,
    "text": "尊者要进入霸体了！",
