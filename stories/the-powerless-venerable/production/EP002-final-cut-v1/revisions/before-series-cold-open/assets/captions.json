  },
  {
    "id": 2,
    "segment": 1,
    "local_start": 4.2,
    "local_end": 5.08,
    "start": 6.3,
    "end": 7.18,
    "text": "怎么办？",
    "image": "assets/captions/002.png"
  },
  {
    "id": 3,
    "segment": 1,
    "local_start": 5.28,
    "local_end": 6.57,
    "start": 7.38,
    "end": 8.67,
    "text": "嘴也不听使唤了！",
    "image": "assets/captions/003.png"
  },
  {
    "id": 4,
    "segment": 1,
    "local_start": 6.9,
    "local_end": 8.4,
    "start": 9.0,
    "end": 10.5,
    "text": "本……我……",
    "image": "assets/captions/004.png"
  },
  {
    "id": 5,
    "segment": 1,
    "local_start": 8.46,
    "local_end": 9.08,
    "start": 10.56,
    "end": 11.18,
    "text": "快撤！",
    "image": "assets/captions/005.png"
  },
  {
    "id": 6,
    "segment": 1,
    "local_start": 9.18,
    "local_end": 10.22,
    "start": 11.28,
    "end": 12.32,
    "text": "尊者要进入霸体了！",
    "image": "assets/captions/006.png"
  },
  {
    "id": 7,
    "segment": 1,
    "local_start": 10.58,
    "local_end": 12.79,
    "start": 12.68,
    "end": 14.89,
    "text": "上次破阵前，他也是这副神色。",
    "image": "assets/captions/007.png"
  },
  {
    "id": 8,
    "segment": 1,
    "local_start": 13.36,
    "local_end": 14.56,
    "start": 15.46,
    "end": 16.66,
    "text": "要动真格了？",
    "image": "assets/captions/008.png"
  },
  {
    "id": 9,
    "segment": 2,
    "local_start": 0.0,
    "local_end": 2.65,
    "start": 17.2,
    "end": 19.85,
    "text": "传说见过霸体全开的，都被抹杀了！",
    "image": "assets/captions/009.png"
  },
  {
    "id": 10,
    "segment": 2,
    "local_start": 2.66,
    "local_end": 4.32,
    "start": 19.86,
    "end": 21.52,
    "text": "别给我加戏啊！",
    "image": "assets/captions/010.png"
  },
  {
    "id": 11,
    "segment": 2,
    "local_start": 4.5,
    "local_end": 5.93,
    "start": 21.7,
    "end": 23.13,
    "text": "这谁顶得住啊？",
    "image": "assets/captions/011.png"
  },
  {
    "id": 12,
    "segment": 2,
    "local_start": 6.16,
    "local_end": 7.7,
    "start": 23.36,
    "end": 24.9,
    "text": "竟要以霸体指点我？",
    "image": "assets/captions/012.png"
  },
  {
    "id": 13,
    "segment": 2,
    "local_start": 8.0,
    "local_end": 9.72,
    "start": 25.2,
    "end": 26.92,
    "text": "还请……留手。",
    "image": "assets/captions/013.png"
  },
  {
    "id": 14,
    "segment": 2,
    "local_start": 10.66,
    "local_end": 11.91,
    "start": 27.86,
    "end": 29.11,
    "text": "天衡宗的迎客鹤！",
    "image": "assets/captions/014.png"
  },
  {
    "id": 15,
    "segment": 3,
    "local_start": 4.14,
    "local_end": 6.83,
    "start": 36.44,
    "end": 39.13,
    "text": "谢道友恕罪，老夫来迟了。",
    "image": "assets/captions/015.png"
  },
  {
    "id": 16,
    "segment": 3,
    "local_start": 7.16,
    "local_end": 9.65,
    "start": 39.46,
    "end": 41.95,
    "text": "镇宗大尊者，岂容你在此胡闹！",
    "image": "assets/captions/016.png"
  },
  {
    "id": 17,
    "segment": 3,
    "local_start": 9.72,
    "local_end": 10.87,
    "start": 42.02,
    "end": 43.17,
    "text": "师尊，弟子只是——",
    "image": "assets/captions/017.png"
  },
  {
    "id": 18,
    "segment": 3,
    "local_start": 10.88,
    "local_end": 11.68,
    "start": 43.18,
    "end": 43.98,
    "text": "先收了法相。",
    "image": "assets/captions/018.png"
  },
  {
    "id": 19,
    "segment": 4,
    "local_start": 0.0,
    "local_end": 2.96,
    "start": 47.4,
    "end": 50.36,
    "text": "请道友移驾，同赴会盟。",
    "image": "assets/captions/019.png"
  },
  {
    "id": 20,
    "segment": 4,
    "local_start": 3.56,
    "local_end": 5.58,
    "start": 50.96,
    "end": 52.98,
    "text": "气息敛得如此干净……",
    "image": "assets/captions/020.png"
  },
  {
    "id": 21,
    "segment": 4,
    "local_start": 5.78,
    "local_end": 7.58,
    "start": 53.18,
    "end": 54.98,
    "text": "大尊者又精进了。",
    "image": "assets/captions/021.png"
  },
  {
    "id": 22,
    "segment": 4,
    "local_start": 7.74,
    "local_end": 8.8,
    "start": 55.14,
    "end": 56.2,
    "text": "道友，请坐。",
    "image": "assets/captions/022.png"
  },
  {
    "id": 23,
    "segment": 4,
    "local_start": 9.2,
    "local_end": 10.04,
    "start": 56.6,
    "end": 57.44,
    "text": "如此甚好。",
    "image": "assets/captions/023.png"
  },
  {
    "id": 24,
    "segment": 4,
    "local_start": 10.36,
    "local_end": 12.17,
    "start": 57.76,
    "end": 59.57,
    "text": "坐稳，抓紧，别往下看。",
    "image": "assets/captions/024.png"
  }
