  },
  {
    "id": 27,
    "segment": 3,
    "local_start": 12.3,
    "local_end": 13.6,
    "start": 44.6,
    "end": 45.9,
    "text": "收剑，随行",
    "image": "assets/captions/027.png"
  },
  {
    "id": 28,
    "segment": 4,
    "local_start": 0.11,
    "local_end": 1.24,
    "start": 47.51,
    "end": 48.64,
