  },
  {
    "id": 22,
    "segment": 3,
    "local_start": 4.94,
    "local_end": 6.08,
    "start": 37.24,
    "end": 38.38,
    "text": "弟、弟子知错",
    "image": "assets/captions/022.png"
  },
  {
    "id": 23,
    "segment": 3,
    "local_start": 6.22,
    "local_end": 6.8,
    "start": 38.52,
    "end": 39.1,
    "text": "啊？",
