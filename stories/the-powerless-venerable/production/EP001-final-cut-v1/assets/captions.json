  },
  {
    "id": 20,
    "segment": 3,
    "local_start": 1.2,
    "local_end": 2.55,
    "start": 33.5,
    "end": 34.85,
    "text": "尊者看出来了？",
    "image": "assets/captions/020.png"
  },
  {
    "id": 21,
    "segment": 3,
    "local_start": 3.26,
    "local_end": 4.74,
    "start": 35.56,
    "end": 37.04,
    "text": "难道礼单漏了什么？",
