    "segment": 1,
    "local_start": 0.02,
    "local_end": 1.12,
    "start": 2.12,
    "end": 3.22,
    "text": "我穿越了",
    "image": "assets/captions/001.png"
  },
  {
    "id": 2,
    "segment": 1,
    "local_start": 1.12,
    "local_end": 2.95,
    "start": 3.22,
    "end": 5.05,
    "text": "成了修仙界的镇宗大尊者",
    "image": "assets/captions/002.png"
  },
  {
    "id": 3,
    "segment": 1,
    "local_start": 3.42,
    "local_end": 4.99,
    "start": 5.52,
    "end": 7.09,
    "text": "可我半点仙力都没有啊！",
    "image": "assets/captions/003.png"
  },
  {
    "id": 4,
    "segment": 1,
    "local_start": 5.56,
    "local_end": 6.14,
    "start": 7.66,
    "end": 8.24,
    "text": "尊者",
    "image": "assets/captions/004.png"
  },
  {
    "id": 5,
    "segment": 1,
    "local_start": 6.34,
    "local_end": 8.0,
    "start": 8.44,
    "end": 10.1,
    "text": "今日赴天衡宗会盟",
    "image": "assets/captions/005.png"
  },
  {
    "id": 6,
    "segment": 1,
    "local_start": 8.28,
    "local_end": 9.7,
    "start": 10.38,
    "end": 11.8,
    "text": "诸位尊者已在等候",
    "image": "assets/captions/006.png"
  },
  {
    "id": 7,
    "segment": 1,
    "local_start": 10.32,
    "local_end": 11.13,
    "start": 12.42,
    "end": 13.23,
    "text": "请登云",
    "image": "assets/captions/007.png"
  },
  {
    "id": 8,
    "segment": 1,
    "local_start": 13.01,
    "local_end": 13.8,
    "start": 15.11,
    "end": 15.9,
    "text": "怎么办？",
    "image": "assets/captions/008.png"
  },
  {
    "id": 9,
    "segment": 1,
    "local_start": 14.05,
    "local_end": 15.07,
    "start": 16.15,
    "end": 17.17,
    "text": "我连飞都不会！",
    "image": "assets/captions/009.png"
  },
  {
    "id": 10,
    "segment": 2,
    "local_start": 0,
    "local_end": 1.68,
    "start": 17.2,
    "end": 18.88,
    "text": "咒语？先试一个！",
    "image": "assets/captions/010.png"
  },
  {
    "id": 11,
    "segment": 2,
    "local_start": 1.84,
    "local_end": 3.4,
    "start": 19.04,
    "end": 20.6,
    "text": "妈咪贝贝烘——飞！",
    "image": "assets/captions/011.png"
  },
  {
    "id": 12,
    "segment": 2,
    "local_start": 4.7,
    "local_end": 5.3,
    "start": 21.9,
    "end": 22.5,
    "text": "蛛丝……",
    "image": "assets/captions/012.png"
  },
  {
    "id": 13,
    "segment": 2,
    "local_start": 5.6,
    "local_end": 6.24,
    "start": 22.8,
    "end": 23.44,
    "text": "走你！",
    "image": "assets/captions/013.png"
  },
  {
    "id": 14,
    "segment": 2,
    "local_start": 6.86,
    "local_end": 7.42,
    "start": 24.06,
    "end": 24.62,
    "text": "御剑",
    "image": "assets/captions/014.png"
  },
  {
    "id": 15,
    "segment": 2,
    "local_start": 7.72,
    "local_end": 8.14,
    "start": 24.92,
    "end": 25.34,
    "text": "起！",
    "image": "assets/captions/015.png"
  },
  {
    "id": 16,
    "segment": 2,
    "local_start": 8.84,
    "local_end": 9.86,
    "start": 26.04,
    "end": 27.06,
    "text": "起啊！",
    "image": "assets/captions/016.png"
  },
  {
    "id": 17,
    "segment": 2,
    "local_start": 12.58,
    "local_end": 13.72,
    "start": 29.78,
    "end": 30.92,
    "text": "尊者怎么不动？",
    "image": "assets/captions/017.png"
  },
  {
    "id": 18,
    "segment": 2,
    "local_start": 14.22,
    "local_end": 15.0,
    "start": 31.42,
    "end": 32.2,
    "text": "云有问题？",
    "image": "assets/captions/018.png"
  },
  {
    "id": 19,
    "segment": 3,
    "local_start": 0,
    "local_end": 0.95,
    "start": 32.3,
    "end": 33.25,
