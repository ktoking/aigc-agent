[
  {
    "start": 2.1,
    "end": 3.06,
    "text": "我穿越了"
  },
  {
    "start": 3.06,
    "end": 4.86,
    "text": "成了修仙界的震踪大尊者"
  },
  {
    "start": 5.26,
    "end": 6.78,
    "text": "可我半点先例都没有啊"
  },
  {
    "start": 7.42,
    "end": 7.98,
    "text": "尊者"
  },
  {
    "start": 8.38,
    "end": 9.82,
    "text": "今日赴天恒宗会盟"
  },
  {
    "start": 10.14,
    "end": 11.5,
    "text": "诸位尊者已在等候"
  },
  {
    "start": 12.18,
    "end": 12.98,
    "text": "请登云"
  },
  {
    "start": 13.34,
    "end": 15.64,
    "text": "怎么办"
  },
  {
    "start": 15.84,
    "end": 16.96,
    "text": "我连飞都不会"
  },
  {
    "start": 16.96,
    "end": 17.68,
    "text": "周宇"
  },
  {
    "start": 17.92,
    "end": 18.68,
    "text": "先试一个"
  },
  {
    "start": 18.92,
    "end": 20.2,
    "text": "马蜜贝贝红飞"
  },
  {
    "start": 21.64,
    "end": 22.28,
    "text": "主司"
  },
  {
    "start": 22.56,
    "end": 23.24,
    "text": "走你"
  },
  {
    "start": 23.8,
    "end": 24.28,
    "text": "宇剑"
  },
  {
    "start": 24.6,
    "end": 25.08,
    "text": "起"
  },
  {
    "start": 26.0,
    "end": 26.68,
    "text": "起啊"
  },
  {
    "start": 27.16,
    "end": 30.53,
    "text": "尊者怎么不动"
  },
  {
    "start": 31.09,
    "end": 31.85,
    "text": "云有问题"
  },
  {
    "start": 31.97,
    "end": 32.85,
    "text": "时辰未到"
  },
  {
    "start": 33.37,
    "end": 34.45,
    "text": "尊者看出来了"
  },
  {
    "start": 35.45,
    "end": 36.77,
    "text": "难道离丹漏了什么"
  },
  {
    "start": 36.97,
    "end": 37.25,
    "text": "弟"
  },
  {
    "start": 37.37,
    "end": 38.09,
    "text": "弟子之错"
  },
  {
    "start": 39.05,
    "end": 40.21,
    "text": "他怎么先自首了"
  },
  {
    "start": 40.53,
    "end": 40.89,
    "text": "本"
  },
  {
    "start": 41.13,
    "end": 42.17,
    "text": "本作今日"
  },
  {
    "start": 42.49,
    "end": 43.05,
    "text": "不醒"
  },
  {
    "start": 43.25,
    "end": 44.09,
    "text": "亲近门人"
  },
  {
    "start": 44.41,
    "end": 45.53,
    "text": "收剑随行"
  },
  {
    "start": 46.09,
    "end": 48.26,
    "text": "山门多远"
  },
  {
    "start": 48.66,
    "end": 49.74,
    "text": "三千级时间"
  },
  {
    "start": 50.7,
    "end": 51.3,
    "text": "备车"
  },
  {
    "start": 51.54,
    "end": 52.06,
    "text": "备车"
  },
  {
    "start": 52.54,
    "end": 52.94,
    "text": "要"
  },
  {
    "start": 52.94,
    "end": 53.82,
    "text": "要有轮子的"
  },
  {
    "start": 55.18,
    "end": 56.38,
    "text": "难道是运辆车"
  },
  {
    "start": 56.66,
    "end": 57.3,
    "text": "就那辆"
  },
  {
    "start": 57.82,
    "end": 60.54,
    "text": "白离尊者的拜帖"
  },
  {
    "start": 60.54,
    "end": 60.94,
    "text": "是"
  },
  {
    "start": 60.94,
    "end": 61.86,
    "text": "上车再说"
  }
