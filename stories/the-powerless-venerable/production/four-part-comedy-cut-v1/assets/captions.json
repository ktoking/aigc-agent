[
  {
    "id": "caption-01",
    "clip": 1,
    "start": 2.12,
    "end": 3.22,
    "text": "我穿越了"
  },
  {
    "id": "caption-02",
    "clip": 1,
    "start": 3.22,
    "end": 5.0,
    "text": "成了修仙界的镇宗大尊者"
  },
  {
    "id": "caption-03",
    "clip": 1,
    "start": 5.18,
    "end": 7.1,
    "text": "可我半点仙力都没有啊！"
  },
  {
    "id": "caption-04",
    "clip": 1,
    "start": 7.54,
    "end": 8.22,
    "text": "尊者"
  },
  {
    "id": "caption-05",
    "clip": 1,
    "start": 8.44,
    "end": 10.05,
    "text": "今日赴天衡宗会盟"
  },
  {
    "id": "caption-06",
    "clip": 1,
    "start": 10.32,
    "end": 11.8,
    "text": "诸位尊者已在等候"
  },
  {
    "id": "caption-07",
    "clip": 1,
    "start": 12.34,
    "end": 13.25,
    "text": "请登云"
  },
  {
    "id": "caption-08",
    "clip": 1,
    "start": 15.11,
    "end": 15.9,
    "text": "怎么办？"
  },
  {
    "id": "caption-09",
    "clip": 1,
    "start": 16.15,
    "end": 17.18,
    "text": "我连飞都不会！"
  },
  {
    "id": "caption-10",
    "clip": 2,
    "start": 17.2,
    "end": 18.88,
    "text": "咒语？先试一个！"
  },
  {
    "id": "caption-11",
    "clip": 2,
    "start": 19.04,
    "end": 20.6,
    "text": "妈咪贝贝烘——飞！"
  },
  {
    "id": "caption-12",
    "clip": 2,
    "start": 21.88,
    "end": 22.5,
    "text": "蛛丝……"
  },
  {
    "id": "caption-13",
    "clip": 2,
    "start": 22.8,
    "end": 23.42,
    "text": "走你！"
  },
  {
    "id": "caption-14",
    "clip": 2,
    "start": 24.02,
    "end": 24.62,
    "text": "御剑"
  },
  {
    "id": "caption-15",
    "clip": 2,
    "start": 24.92,
    "end": 25.3,
    "text": "起！"
  },
  {
    "id": "caption-16",
    "clip": 2,
    "start": 26.04,
    "end": 27.1,
    "text": "起啊！"
  },
  {
    "id": "caption-17",
    "clip": 2,
    "start": 29.78,
    "end": 30.9,
    "text": "尊者怎么不动？"
  },
  {
    "id": "caption-18",
    "clip": 2,
    "start": 31.42,
    "end": 32.2,
    "text": "云有问题？"
  },
  {
    "id": "caption-19",
    "clip": 3,
    "start": 32.3,
    "end": 33.22,
    "text": "时辰未到……"
  },
  {
    "id": "caption-20",
    "clip": 3,
    "start": 33.5,
    "end": 34.85,
    "text": "尊者看出来了？"
  },
  {
    "id": "caption-21",
    "clip": 3,
    "start": 35.5,
    "end": 37.04,
    "text": "难道礼单漏了什么？"
  },
  {
    "id": "caption-22",
    "clip": 3,
    "start": 37.22,
    "end": 38.38,
    "text": "弟、弟子知错"
  },
  {
    "id": "caption-23",
    "clip": 3,
    "start": 38.68,
    "end": 39.07,
    "text": "啊？"
  },
  {
    "id": "caption-24",
    "clip": 3,
    "start": 39.32,
    "end": 40.55,
    "text": "他怎么先自首了？"
  },
  {
    "id": "caption-25",
    "clip": 3,
    "start": 40.86,
    "end": 42.28,
    "text": "本、本座今日……"
  },
  {
    "id": "caption-26",
    "clip": 3,
    "start": 42.7,
    "end": 44.46,
    "text": "步行，亲近门人"
  },
  {
    "id": "caption-27",
    "clip": 3,
    "start": 44.7,
    "end": 45.92,
    "text": "收剑，随行"
  },
  {
    "id": "caption-28",
    "clip": 4,
    "start": 47.51,
    "end": 48.64,
    "text": "山门多远？"
  },
  {
    "id": "caption-29",
    "clip": 4,
    "start": 48.75,
    "end": 50.06,
    "text": "三千级石阶"
  },
  {
    "id": "caption-30",
    "clip": 4,
    "start": 50.25,
    "end": 51.58,
    "text": "备……备车"
  },
  {
    "id": "caption-31",
    "clip": 4,
    "start": 51.91,
    "end": 52.54,
    "text": "备车？"
  },
  {
    "id": "caption-32",
    "clip": 4,
    "start": 52.91,
    "end": 54.24,
    "text": "要、要有轮子的"
  },
  {
    "id": "caption-33",
    "clip": 4,
    "start": 55.31,
    "end": 56.7,
    "text": "难道是运粮车？"
  },
  {
    "id": "caption-34",
    "clip": 4,
    "start": 56.95,
    "end": 57.62,
    "text": "就那辆"
  },
  {
    "id": "caption-35",
    "clip": 4,
    "start": 59.64,
    "end": 60.89,
    "text": "白璃尊者的拜帖——"
  },
  {
    "id": "caption-36",
    "clip": 4,
    "start": 60.96,
    "end": 62.2,
    "text": "上、上车再说"
  }
]
