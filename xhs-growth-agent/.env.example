# 复制为 .env；不提交真实凭证或 Cookie。环境变量优先于本文件。
# 默认使用本机 Codex CLI；模型固定 gpt-6.1-sol，推理强度 high。
# 请先完成 codex login；Mock 仅用于隔离流程测试，不代表真实创作。
XHS_MODEL_MODE=live
# 单次 Codex CLI 执行等待；范围 30–1800 秒，不自动更换模型或重试。
XHS_CODEX_TIMEOUT_SECONDS=600
# 仅本机 loopback，不能改成公网、0.0.0.0 或带凭证 URL。
XHS_MCP_URL=http://127.0.0.1:18060/mcp
# 真实发布单次 RPC 等待 600 秒，避免平台上传较慢导致过早断开；绝不自动重试。
XHS_PUBLISH_TIMEOUT_SECONDS=600
# CLI 单次本机 HTTP 等待，最低 900 秒；默认 1800 秒，不重试请求。
XHS_CLI_HTTP_TIMEOUT_SECONDS=1800
# 普通 Chrome；留空不覆盖默认 /Applications/Google Chrome.app。
# XHS_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 本机数据目录由项目计算；不需要填写 Cookie。
# 初次建库默认值；已有数据库的后台设置优先。
XHS_DAILY_LIMIT=3
XHS_PRODUCTION_TARGET=50
XHS_SCHEDULER_ENABLED=false
# approval_to_queue 在后台设置启用并绑定实际账号；不通过 .env 静默开启。
